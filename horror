local function randomMapPoint(minR, maxR, around)
	local tgt = getTarget()
	local c = around or (tgt and tgt.hrp.Position) or mapOrigin

	local ignore = {}
	if player.Character then table.insert(ignore, player.Character) end
	if currentMonster then table.insert(ignore, currentMonster.model) end
	if itemsFolder then table.insert(ignore, itemsFolder) end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignore

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = ignore

	for _ = 1, 30 do
		local a = math.random() * math.pi * 2
		local r = minR + math.random() * (maxR - minR)
		local x, z = c.X + math.cos(a) * r, c.Z + math.sin(a) * r
		-- the ray goes top-down from just above head height so it does not hit the roof
		local hit = workspace:Raycast(Vector3.new(x, c.Y + 6, z), Vector3.new(0, -80, 0), rayParams)
		if hit and hit.Normal.Y > 0.85 and hit.Instance.CanCollide and hit.Material ~= Enum.Material.Water then
			local pos = hit.Position
			-- there must be free space above the point (not inside a wall or furniture)
			local parts = workspace:GetPartBoundsInRadius(pos + Vector3.new(0, 5, 0), 3.5, overlap)
			if #parts == 0 then
				return pos
			end
		end
	end
	return nil
end

local function canReach(a, b)
	local path = PathfindingService:CreatePath({AgentRadius = 2.5, AgentHeight = 7, AgentCanJump = true})
	local ok = pcall(function()
		path:ComputeAsync(a, b)
	end)
	return ok and path.Status == Enum.PathStatus.Success
end

local function getMonsterSpawn()
	local tgt = getTarget()
	local c = tgt and tgt.hrp.Position or mapOrigin
	local first
	for _ = 1, 8 do
		local p = randomMapPoint(CONFIG.MonsterSpawnDistance * 0.7, CONFIG.MonsterSpawnDistance * 1.3, c)
		if p then
			first = first or p
			if canReach(c, p) then
				return p + Vector3.new(0, 9, 0)
			end
		end
	end
	return first and (first + Vector3.new(0, 9, 0)) or nil
end

local function spawnItems()
	itemsFolder = Instance.new("Folder")
	itemsFolder.Name = "HorrorItems"
	itemsFolder.Parent = workspace

	local pool = {"flares", "flares", "flares", "flares", "medkit", "medkit", "medkit", "energy", "energy", "energy", "flaregun"}
	local placed = {}

	local function farEnough(p, minDist)
		for _, q in ipairs(placed) do
			if (p - q).Magnitude < minDist then return false end
		end
		return true
	end

	-- places an item no closer than ItemMinDistance to the others
	-- (if space is tight, the requirement is halved near the end of the attempts)
	local function place(kind, minR, maxR)
		for attempt = 1, 40 do
			local minDist = attempt <= 30 and CONFIG.ItemMinDistance or CONFIG.ItemMinDistance * 0.5
			local p = randomMapPoint(minR, maxR, mapOrigin)
			if p and farEnough(p, minDist) then
				table.insert(placed, p)
				makeItem(kind, p + Vector3.new(0, 0.05, 0), itemsFolder)
				return true
			end
		end
		return false
	end

	-- the Flare Gun and flares are guaranteed, but not right next to each other
	place("flaregun", 20, 60)
	place("flares", 40, 110)

	for _ = 1, CONFIG.ItemsOnMap do
		place(pool[math.random(1, #pool)], 15, CONFIG.ItemRadius)
	end
end

