local Hub = {}
Hub.__index = Hub

function Hub.build(callbacks)
	local self = setmetatable({}, Hub)
	self.conns = {}
	self.sounds = {}
	self.alive = true

	local cam = workspace.CurrentCamera
	local L = CONFIG.Lobby
	local origin = L.Origin

	-- remember everything the lobby changes so it can be restored exactly
	self.saved = {
		camType = cam.CameraType,
		fov = cam.FieldOfView,
		lighting = snapshotLighting(),
	}
	self.stashed = stashLightingObjects()

	-- the character stands still while you are in the lobby
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	self.frozen = {hum = hum, hrp = hrp}
	if hum then
		self.frozen.walk, self.frozen.jumpPower, self.frozen.jumpHeight = hum.WalkSpeed, hum.JumpPower, hum.JumpHeight
		hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0
	end
	if hrp then
		self.frozen.anchored = hrp.Anchored
		hrp.Anchored = true
	end

	----------------------------------------------------------
	-- 3D scene (far above the map): ground, forest, moon, monster, lights
	----------------------------------------------------------
	local folder = Instance.new("Folder")
	folder.Name = "HorrorLobby"
	folder.Parent = workspace
	self.folder = folder

	local rng = Random.new(77)
	local function P(size, cf, color, material, shape)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.Slate
		if shape then p.Shape = shape end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = folder
		return p
	end

	P(Vector3.new(800, 2, 800), CFrame.new(origin.X, origin.Y - 1, origin.Z - 200), Color3.fromRGB(14, 22, 14), Enum.Material.Grass)

	local trunkColor = Color3.fromRGB(30, 22, 18)
	local leafColor = Color3.fromRGB(14, 32, 20)
	local function tree(x, z)
		local h = rng:NextNumber(26, 46)
		local th = rng:NextNumber(2.2, 4)
		P(Vector3.new(h, th, th), CFrame.new(origin.X + x, origin.Y + h / 2, origin.Z + z) * CFrame.Angles(0, 0, math.rad(90)),
			trunkColor, Enum.Material.Wood, Enum.PartType.Cylinder)
		local r = rng:NextNumber(14, 22)
		P(Vector3.new(r, r, r), CFrame.new(origin.X + x, origin.Y + h - 2, origin.Z + z), leafColor, Enum.Material.LeafyGrass, Enum.PartType.Ball)
		local r2 = r * 0.75
		P(Vector3.new(r2, r2, r2), CFrame.new(origin.X + x + rng:NextNumber(-3, 3), origin.Y + h - 8, origin.Z + z + rng:NextNumber(-3, 3)),
			leafColor, Enum.Material.LeafyGrass, Enum.PartType.Ball)
	end

	-- the forest behind the monster
	for _ = 1, L.Trees do
		local x = rng:NextNumber(-160, 160)
		local z = -rng:NextNumber(16, 240)
		if not (math.abs(x) < 6 and z > -30) then tree(x, z) end
	end
	-- a few trees framing the scene on both sides
	for i = 1, 10 do
		local side = (i % 2 == 0) and 1 or -1
		tree(side * rng:NextNumber(32, 60), rng:NextNumber(-34, 16))
	end

	-- a pale moon
	P(Vector3.new(60, 60, 60), CFrame.new(origin.X - 70, origin.Y + 110, origin.Z - 260), Color3.fromRGB(205, 215, 235), Enum.Material.Neon, Enum.PartType.Ball)

	-- the monster, standing still and breathing, facing the camera
	local m = buildMonster()
	for _, d in ipairs(m.model:GetDescendants()) do
		if d:IsA("Sound") then d:Destroy() end
	end
	m.root.Anchored = true
	m.model.Parent = folder
	m.root.CFrame = CFrame.new(origin.X, origin.Y + 10.1 * CONFIG.MonsterScale, origin.Z) * CFrame.Angles(0, math.pi, 0)

	-- cold key light from the front, faint red rim light behind the monster
	local keyPart = P(Vector3.new(1, 1, 1), CFrame.lookAt(origin + Vector3.new(10, 26, 36), origin + Vector3.new(0, 7, 0)), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
	keyPart.Transparency = 1
	new("SpotLight", {Face = Enum.NormalId.Front, Range = 110, Angle = 55, Brightness = 2.4, Color = Color3.fromRGB(165, 185, 230), Shadows = true}, keyPart, true)
	local rimPart = P(Vector3.new(1, 1, 1), CFrame.new(origin + Vector3.new(0, 9, -10)), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
	rimPart.Transparency = 1
	new("PointLight", {Color = Color3.fromRGB(255, 50, 35), Range = 40, Brightness = 1.6}, rimPart, true)

	-- lobby atmosphere
	local lobbyLight = {
		ClockTime = 0, Brightness = 0.05,
		Ambient = Color3.fromRGB(16, 20, 30), OutdoorAmbient = Color3.fromRGB(16, 20, 30),
		ColorShift_Top = Color3.new(0, 0, 0), ColorShift_Bottom = Color3.new(0, 0, 0),
		GlobalShadows = true, EnvironmentDiffuseScale = 0.1, EnvironmentSpecularScale = 0,
		FogColor = Color3.fromRGB(6, 8, 12), FogStart = 40, FogEnd = 330,
	}
	for k, v in pairs(lobbyLight) do
		pcall(function() Lighting[k] = v end)
	end

	local drone = makeSound(workspace, CONFIG.Sounds.Ambient, {Looped = true, Volume = 0.3, PlaybackSpeed = 0.3})
	if drone then
		addReverb(drone, -3)
		drone:Play()
		table.insert(self.sounds, drone)
	end
	local clickSnd = makeSound(workspace, CONFIG.Sounds.Click, {Volume = 0.6})
	if clickSnd then table.insert(self.sounds, clickSnd) end

	----------------------------------------------------------
	-- camera: slow drifting shot of the monster
	----------------------------------------------------------
	local t0 = os.clock()
	table.insert(self.conns, RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable
		local sway = Vector3.new(math.sin(t * 0.21) * 1.4, math.sin(t * 0.13) * 0.5, math.sin(t * 0.17) * 0.8)
		local pos = origin + Vector3.new(0, 8, 34) + sway
		cam.CFrame = CFrame.lookAt(pos, origin + Vector3.new(0, 8.5, 0)) * CFrame.Angles(0, 0, math.sin(t * 0.11) * 0.015)
		cam.FieldOfView = 52
	end))
	table.insert(self.conns, RunService.Heartbeat:Connect(function(dt)
		m.update(dt, 0, "patrol", 0, false)
	end))

	----------------------------------------------------------
	-- UI
	----------------------------------------------------------
	local gui = new("ScreenGui", {
		Name = "HorrorHub",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 200,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	self.gui = gui

	-- vignette
	local function vig(pos, size, rot)
		local f = new("Frame", {Position = pos, Size = size, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.2, BorderSizePixel = 0}, gui)
		new("UIGradient", {Rotation = rot, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})}, f)
	end
	vig(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.3, 0), 90)
	vig(UDim2.new(0, 0, 0.7, 0), UDim2.new(1, 0, 0.3, 0), 270)
	vig(UDim2.new(0, 0, 0, 0), UDim2.new(0.22, 0, 1, 0), 0)
	vig(UDim2.new(0.78, 0, 0, 0), UDim2.new(0.22, 0, 1, 0), 180)

	new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 36), Size = UDim2.fromOffset(700, 90),
		BackgroundTransparency = 1, Text = "HORROR MODE", Font = Enum.Font.Creepster, TextSize = 78,
		TextColor3 = Color3.fromRGB(215, 40, 35), TextStrokeTransparency = 0.3,
	}, gui)
	new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 122), Size = UDim2.fromOffset(700, 28),
		BackgroundTransparency = 1, Text = "Don't turn around.", Font = Enum.Font.GothamMedium, TextSize = 20,
		TextColor3 = Color3.fromRGB(200, 205, 215), TextStrokeTransparency = 0.6,
	}, gui)

	local function makeButton(text, pos, color, onClick)
		local b = new("TextButton", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(210, 58),
			BackgroundColor3 = color, BackgroundTransparency = 0.2, AutoButtonColor = false,
			Text = text, Font = Enum.Font.GothamBold, TextSize = 26, TextColor3 = Color3.new(1, 1, 1),
		}, gui)
		new("UICorner", {CornerRadius = UDim.new(0, 8)}, b)
		new("UIStroke", {Color = Color3.fromRGB(235, 235, 235), Thickness = 1.5, Transparency = 0.5}, b)
		table.insert(self.conns, b.MouseEnter:Connect(function()
			TweenService:Create(b, TweenInfo.new(0.12), {BackgroundTransparency = 0, Size = UDim2.fromOffset(222, 62)}):Play()
		end))
