	RotSpeed = NumberRange.new(-30, 30), EmissionDirection = Enum.NormalId.Front, LockedToPart = false,
	Color = ColorSequence.new(Color3.fromRGB(255, 245, 225)),
}, lightPart, true)

-- faint dust filling the air around you
Torch.dustBox = torchPart({Name = "HorrorDust", Transparency = 1, Size = Vector3.new(70, 30, 70)})
Torch.ambientDust = safeNew("ParticleEmitter", {
