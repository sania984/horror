local function makeCard(index, title, iconText, iconColor, hint, useCallback)
	local card = new("Frame", {
		Position = UDim2.new(0, 20 + (index - 1) * 152, 0, 72),
		Size = UDim2.fromOffset(140, 210),
		BackgroundColor3 = Color3.fromRGB(26, 30, 26),
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 6,
	}, invPanel)
	new("UICorner", {CornerRadius = UDim.new(0, 6)}, card)

	local icon = new("Frame", {
		Position = UDim2.new(0.5, -40, 0, 10),
		Size = UDim2.fromOffset(80, 56),
		BackgroundColor3 = iconColor,
		BorderSizePixel = 0,
		ZIndex = 7,
	}, card)
	new("UICorner", {CornerRadius = UDim.new(0, 6)}, icon)
	invText(iconText, UDim2.new(0, 0, 0, 0), UDim2.fromScale(1, 1), 24, Color3.new(0, 0, 0), icon).ZIndex = 8

	invText(title, UDim2.new(0, 0, 0, 74), UDim2.new(1, 0, 0, 22), 17, nil, card)
	local count = invText("", UDim2.new(0, 0, 0, 98), UDim2.new(1, 0, 0, 28), 22, Color3.fromRGB(255, 235, 170), card)
	invText(hint, UDim2.new(0, 6, 0, 130), UDim2.new(1, -12, 0, 32), 14, Color3.fromRGB(160, 165, 155), card)

	if useCallback then
		local btn = new("TextButton", {
			Position = UDim2.new(0, 10, 1, -40),
			Size = UDim2.new(1, -20, 0, 30),
			BackgroundColor3 = Color3.fromRGB(60, 90, 60),
			BorderSizePixel = 0,
			Text = "USE",
			Font = Enum.Font.Code,
			TextSize = 15,
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 8,
		}, card)
		new("UICorner", {CornerRadius = UDim.new(0, 4)}, btn)
		btn.Activated:Connect(useCallback)
	end
	return {card = card, count = count}
end

