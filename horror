-- START: scatter the items, fade in ("spawn in") and start the monster
------------------------------------------------------------
killFade.BackgroundTransparency = 0 -- start black (continues the lobby fade); it fades in once the world is ready

task.spawn(function()
	local ch = player.Character or player.CharacterAdded:Wait()
	local hrp = ch:WaitForChild("HumanoidRootPart")
	task.wait(1)
	if not alive then return end
	mapOrigin = hrp.Position

	if FEAT.Items then
		local ok, err = pcall(spawnItems)
		if not ok then warn("[HorrorMode] Items could not be placed: " .. tostring(err)) end
	end

	-- after you die the monster moves to a new place near your new spawn
	C(player.CharacterAdded, function()
		monsterNeedsReset = true
	end)

	FX.fadeIn(1.4)
	showToast("You are in. Survive.")

	local runOpts = nil
	local errors = 0
	while alive do
		local ok, result = pcall(runMonster, runOpts)
		runOpts = nil
		if not ok then
			errors += 1
			warn("[HorrorMode] Monster error: " .. tostring(result))
			if errors >= 5 then
				warn("[HorrorMode] The monster failed 5 times - stopping it.")
				break
			end
			currentMonster = nil
			task.wait(2)
		elseif result == "decoy" then
			-- the monster is disguised as a player; when you come close it bursts out
			local okD, info = pcall(runDecoy, pendingDecoyPoint)
			if okD and info then
				runOpts = {emerge = info}
			elseif not okD then
				warn("[HorrorMode] Decoy error: " .. tostring(info))
			end
		elseif not result then
			task.wait(2)
		else
			task.wait(CONFIG.MonsterRespawnTime)
		end
	end
end)

------------------------------------------------------------
-- STOP: undo everything this session did
------------------------------------------------------------
stopGame = function()
	if not alive then return end
	alive = false
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end

	-- objects this session created in the world
	for _, o in ipairs(workspace:GetChildren()) do
		local n = o.Name
		if n == "HorrorMonster" or n == "HorrorDecoy" or n == "HorrorItems" or n == "HorrorFlare" or n == "HorrorFX" or n == "HorrorFigure" then
			pcall(function() o:Destroy() end)
		end
	end
	pcall(function() gui:Destroy() end)
	for _, p in ipairs(Torch.attached) do pcall(function() p:Destroy() end) end
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:GetAttribute("HorrorKeep") then pcall(function() c:Destroy() end) end
	end

	-- give the game its sky, atmosphere, effects, lamps and lighting back
	unstashLightingObjects(saved.stashed)
	restoreLighting(saved.lighting)
	for l in pairs(saved.lights) do
		pcall(function() l.Enabled = true end)
	end

	-- player and camera
	pcall(function() player.CameraMode = saved.cameraMode end)
	local cam = workspace.CurrentCamera
	pcall(function()
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = saved.fov
	end)
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hum then
		pcall(function()
			hum.CameraOffset = Vector3.zero
			if saved.walkSpeed then hum.WalkSpeed = saved.walkSpeed end
			hum.JumpPower, hum.JumpHeight = 50, 7.2
		end)
	end
	if hrp then pcall(function() hrp.Anchored = false end) end
	if saved.runningVolume and hrp then
		local running = hrp:FindFirstChild("Running")
		if running and running:IsA("Sound") then running.Volume = saved.runningVolume end
	end

	-- every sound this script created
	for _, s in pairs(Runtime.sounds) do
		pcall(function() s:Destroy() end)
	end

	if opts.onQuit then task.defer(opts.onQuit) end
end

-- hotkey: leave the game and go back to the lobby
C(UserInputService.InputBegan, function(input, gpe)
	if not gpe and input.KeyCode == CONFIG.StopKey then
		stopGame()
	end
end)

return stopGame
end


------------------------------------------------------------
-- BOOT: lobby <-> game
--   PLAY  -> destroys the lobby and starts a game session
--   STOP  -> stops everything, restores the game and deletes this script
--   quit to lobby (inventory button or [End]) -> ends the session and shows the lobby again
------------------------------------------------------------
local hub = nil
local startFailures = 0
local stopSession = nil
local showHub

local function shutdown()
	if stopSession then
		pcall(stopSession)
		stopSession = nil
	end
	if hub then
		pcall(function() hub:destroy() end)
		hub = nil
	end
	print("[HorrorMode] Stopped and removed.")
	pcall(function()
		if script then script:Destroy() end
	end)
end

local function startPlaying()
	hub = nil
	local ok, stopFn = pcall(startGame, {
		onQuit = function()
			stopSession = nil
			showHub()
		end,
	})
	if ok then
		stopSession = stopFn
	else
		warn("[HorrorMode] Could not start the game: " .. tostring(stopFn))
		startFailures += 1
		if startFailures >= 2 then
			shutdown()
		else
			showHub()
		end
	end
end

showHub = function()
	local ok, h = pcall(Hub.build, {onPlay = startPlaying, onStop = shutdown})
	if ok then
		hub = h
	else
		-- if the lobby cannot be built (unsupported game), skip it and start playing right away
		warn("[HorrorMode] Lobby unavailable (" .. tostring(h) .. "), starting the game directly.")
		startPlaying()
	end
end

showHub()
