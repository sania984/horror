local function getTarget()
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then
		return {char = ch, hum = hum, hrp = hrp}
	end
	return nil
end

local monsterNeedsReset = false
local mapOrigin = Vector3.zero
local itemsFolder = nil

local function flatDist(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function stunMonster(seconds)
	local m = currentMonster
	if m then
		m.stunUntil = math.max(m.stunUntil or 0, os.clock() + seconds)
	end
end

local function killPlayer(target)
	-- BreakJoints from a client is often rejected by the server (RejectCharacterDeletions),
	-- so we kill through Health and the Dead state; BreakJoints is only a fallback
	pcall(function() target.hum.Health = 0 end)
	pcall(function() target.hum:ChangeState(Enum.HumanoidStateType.Dead) end)
	pcall(function() target.char:BreakJoints() end)
end

