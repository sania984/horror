local function new(class, props, parent, keep)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if keep then o:SetAttribute("HorrorKeep", true) end
	o.Parent = parent
	return o
end

local function makeSound(parent, id, props)
	if not id or id == "" then return nil end
	local s = Instance.new("Sound")
	s.SoundId = id
	for k, v in pairs(props or {}) do s[k] = v end
	s.Parent = parent
	return s
end

local function addReverb(sound, wet)
	if not sound then return end
	local r = Instance.new("ReverbSoundEffect")
	r.DecayTime = 3
	r.Density = 1
	r.Diffusion = 1
	r.DryLevel = -2
	r.WetLevel = wet or -6
	r.Parent = sound
end

local function addDistortion(sound, level)
	if not sound then return end
	local d = Instance.new("DistortionSoundEffect")
	d.Level = level
	d.Parent = sound
end

