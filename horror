	Lighting.FogColor = Color3.new(0, 0, 0)
	Lighting.FogStart = 0
	Lighting.FogEnd = CONFIG.FogEnd
end

local function purgeLighting(child)
	if (child:IsA("Sky") or child:IsA("Atmosphere") or child:IsA("PostEffect"))
		and not child:GetAttribute("HorrorKeep") then
		child:Destroy()
	end
end

