-- bounce light: a soft point light sitting on the lit surface, tinted by the surface color
Torch.bouncePart = torchPart({Name = "HorrorFlashlightBounce", Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2)})
Torch.bounce = new("PointLight", {Color = Color3.fromRGB(255, 236, 205), Range = 14, Brightness = 0.6, Shadows = false, Enabled = false}, Torch.bouncePart, true)

-- the flashlight in your hand (axis of the cylinders points forward)
local function viewPart(size, offset, color, material)
	local p = torchPart({Name = "HorrorTorchModel", Size = size, Color = color, Material = material, Shape = Enum.PartType.Cylinder})
	table.insert(Torch.viewParts, {part = p, off = offset})
	return p
end
viewPart(Vector3.new(1.5, 0.34, 0.34), 0, Color3.fromRGB(22, 22, 26), Enum.Material.Metal)       -- handle
viewPart(Vector3.new(0.55, 0.54, 0.54), 0.95, Color3.fromRGB(38, 38, 44), Enum.Material.Metal)   -- head
viewPart(Vector3.new(0.08, 0.62, 0.62), 1.24, Color3.fromRGB(80, 80, 88), Enum.Material.Metal)   -- bezel
Torch.lens = viewPart(Vector3.new(0.05, 0.46, 0.46), 1.28, Color3.fromRGB(255, 240, 210), Enum.Material.Neon)

function Torch.setQuality(q, fxOn)
	local layers, bounce, dustRate, ambRate, view = q.Layers, q.Bounce, q.Dust, q.AmbientDust, true
	if not fxOn then
		layers, bounce, dustRate, ambRate, view = math.min(layers, 2), false, 0, 0, false
	end
	Torch.layerCount = layers
	Torch.bounceAllowed = bounce
	if typeof(Torch.dust) == "Instance" then Torch.dust.Rate = dustRate end
	if typeof(Torch.ambientDust) == "Instance" then
		Torch.ambientDust.Rate = ambRate
		Torch.ambientDust.Enabled = ambRate > 0
	end
	for _, vp in ipairs(Torch.viewParts) do vp.part.Transparency = view and 0 or 1 end
	for _, L in ipairs(Torch.layers) do L.light.Shadows = L.shadows and q.Shadows end
end

-- called every frame by the main loop
function Torch.update(dt, now, on, dim, moveSpeed, crawlK, monsterModel)
	if lightPart.Parent ~= camera then
		for _, p in ipairs(Torch.attached) do p.Parent = camera end
	end
	local cam = camera.CFrame
	Torch.t += dt

	-- the held light lags a little behind the camera (weight and inertia)
	Torch.viewCF = Torch.viewCF:Lerp(cam, math.clamp(dt * 22, 0, 1))
	local k = math.clamp(moveSpeed / 16, 0, 1.3)
	local sway = CFrame.new(math.sin(Torch.t * 5) * 0.012 * k, math.abs(math.sin(Torch.t * 5)) * 0.02 * k, 0)
	local handCF = Torch.viewCF * CFrame.new(0.62, -0.5, -1.1) * sway
	local aimDir = Torch.viewCF.LookVector:Lerp(cam.LookVector, 0.6)
	if aimDir.Magnitude < 0.01 then aimDir = cam.LookVector end
	aimDir = aimDir.Unit
	local lensPos = (Torch.viewCF * CFrame.new(0.55, -0.42, -1.6)).Position
	lightPart.CFrame = CFrame.lookAt(lensPos, cam.Position + aimDir * 60)

	-- warm-up when switched on, quick fade when switched off, slight filament shimmer
	Torch.level += ((on and 1 or 0) - Torch.level) * math.min(dt * (on and 16 or 26), 1)
	local level = Torch.level
	local power = level * dim * (1 + math.noise(now * 9, 0.5, 0) * 0.04)
	local enabled = level > 0.02
	for i, L in ipairs(Torch.layers) do
		local active = enabled and i <= Torch.layerCount
		L.light.Enabled = active
		if active then L.light.Brightness = L.base * power end
	end

	if typeof(Torch.dust) == "Instance" then Torch.dust.Enabled = level > 0.15 and Torch.dust.Rate > 0 end
	Torch.dustBox.CFrame = CFrame.new(cam.Position)

	-- bounce light on the surface the beam hits
	if enabled and Torch.bounceAllowed then
		Torch.rayT -= dt
		if Torch.rayT <= 0 then
			Torch.rayT = 0.25
			local ignore = {lightPart, Torch.bouncePart, Torch.dustBox}
			if player.Character then table.insert(ignore, player.Character) end
			if monsterModel then table.insert(ignore, monsterModel) end
			for _, vp in ipairs(Torch.viewParts) do table.insert(ignore, vp.part) end
			Torch.rayParams.FilterDescendantsInstances = ignore
		end
		local hit = workspace:Raycast(lensPos, aimDir * CONFIG.FlashlightRange, Torch.rayParams)
		if hit then
			local target = hit.Position + hit.Normal * 1.4
			Torch.bouncePos = Torch.bouncePos and Torch.bouncePos:Lerp(target, math.min(dt * 14, 1)) or target
			Torch.bouncePart.CFrame = CFrame.new(Torch.bouncePos)
			local dist = (hit.Position - lensPos).Magnitude
			Torch.bounce.Range = math.clamp(6 + dist * 0.18, 8, 26)
			Torch.bounce.Brightness = math.clamp(0.95 - dist / 180, 0.25, 0.95) * power * FXC.Bounce
			local c = Color3.fromRGB(255, 236, 205)
			local okC, surf = pcall(function() return hit.Instance.Color end)
			if okC and typeof(surf) == "Color3" then c = c:Lerp(surf, 0.35) end
			Torch.bounce.Color = c
			Torch.bounce.Enabled = true
		else
			Torch.bounce.Enabled = false
		end
	else
		Torch.bounce.Enabled = false
	end

	-- the flashlight model in your hand
	local lensNow = level > 0.3
	if lensNow ~= Torch.lensOn then
		Torch.lensOn = lensNow
		Torch.lens.Material = lensNow and Enum.Material.Neon or Enum.Material.Metal
		Torch.lens.Color = lensNow and Color3.fromRGB(255, 240, 210) or Color3.fromRGB(60, 60, 64)
	end
	local base = handCF * CFrame.Angles(0, math.rad(90), 0)
	for _, vp in ipairs(Torch.viewParts) do
		vp.part.CFrame = base * CFrame.new(vp.off, 0, 0)
	end
end

