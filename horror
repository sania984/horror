-- 4. HALLUCINATIONS: a shadow figure at the edge of view, eyes in the dark, a flashed whisper
----------------------------------------------------------
local hallLabel = new("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.42, 0), Size = UDim2.fromOffset(760, 80),
	BackgroundTransparency = 1, Text = "", Font = Enum.Font.Creepster, TextSize = 58,
	TextColor3 = Color3.fromRGB(200, 25, 25), TextStrokeTransparency = 0.4, Visible = false, ZIndex = 12,
}, gui)

local function clearFigure()
	if FXS.figure then
		pcall(function() FXS.figure.model:Destroy() end)
		FXS.figure = nil
	end
end

local function clearEyes()
	if FXS.eyes then
		pcall(function() FXS.eyes.model:Destroy() end)
		FXS.eyes = nil
	end
end

local function spawnFigure()
	if FXS.figure then return end
	local tgt = getTarget()
	local flat = flatLook()
	if not tgt or not flat then return end
	for _ = 1, 10 do
		local ang = math.rad(rr(32, 62)) * (math.random() < 0.5 and 1 or -1)
		local dir = CFrame.Angles(0, ang, 0):VectorToWorldSpace(flat)
		local p = tgt.hrp.Position + dir * rr(34, 62)
		local g = groundPoint(p.X, p.Z, tgt.hrp.Position.Y)
		if g then
			local model = Instance.new("Model")
			model.Name = "HorrorFigure"
			local base = CFrame.lookAt(g, Vector3.new(tgt.hrp.Position.X, g.Y, tgt.hrp.Position.Z))
			local function part(size, off, color, material, shape)
				local pt = Instance.new("Part")
				pt.Anchored = true
				pt.CanCollide = false
				pt.CanQuery = false
				pt.CanTouch = false
				pt.Size = size
				pt.CFrame = base * off
				pt.Color = color
				pt.Material = material or Enum.Material.Slate
				if shape then pt.Shape = shape end
				pt.Parent = model
				return pt
			end
			local black = Color3.fromRGB(8, 8, 10)
			part(Vector3.new(1.0, 5.6, 0.6), CFrame.new(0, 2.8, 0), black)
			local head = part(Vector3.new(0.95, 1.2, 0.8), CFrame.new(0, 6.2, 0), black)
			part(Vector3.new(0.3, 5.0, 0.3), CFrame.new(-0.75, 3.5, 0), black)
			part(Vector3.new(0.3, 5.0, 0.3), CFrame.new(0.75, 3.5, 0), black)
			for _, side in ipairs({-1, 1}) do
				part(Vector3.new(0.18, 0.18, 0.18), CFrame.new(side * 0.22, 6.25, -0.42), CONFIG.MonsterEyeColor, Enum.Material.Neon, Enum.PartType.Ball)
			end
			model.Parent = fxFolder
			FXS.figure = {model = model, head = head, born = os.clock(), seenT = 0}
			return
		end
	end
end

local function spawnEyes()
	if FXS.eyes then return end
	local tgt = getTarget()
	local flat = flatLook()
	if not tgt or not flat then return end
	local ang = math.rad(rr(-55, 55))
	local dir = CFrame.Angles(0, ang, 0):VectorToWorldSpace(flat)
	local pos = tgt.hrp.Position + dir * rr(18, 40) + Vector3.new(0, rr(0.5, 2.5), 0)
	local model = Instance.new("Model")
	model.Name = "HorrorEyes"
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local parts = {}
	for _, side in ipairs({-1, 1}) do
		local pt = Instance.new("Part")
		pt.Anchored = true
		pt.CanCollide = false
		pt.CanQuery = false
		pt.CanTouch = false
		pt.Shape = Enum.PartType.Ball
		pt.Size = Vector3.new(0.35, 0.35, 0.35)
		pt.Material = Enum.Material.Neon
		pt.Color = CONFIG.MonsterEyeColor
		pt.CFrame = CFrame.new(pos + right * side * 0.45)
		pt.Parent = model
		table.insert(parts, pt)
	end
	model.Parent = fxFolder
	FXS.eyes = {model = model, parts = parts, pos = pos, born = os.clock(), seenT = 0, blinkAt = os.clock() + rr(0.5, 1.2), blinkUntil = 0}
end

local function whisperText()
	local list = CONFIG.Hallucination.Texts
	if #list == 0 then return end
	hallLabel.Text = list[math.random(1, #list)]
	hallLabel.Position = UDim2.new(0.5, math.random(-60, 60), 0.42, math.random(-30, 30))
	hallLabel.Visible = true
	staticBurst = math.max(staticBurst, 0.6)
	glitch = 1
	task.delay(rr(0.1, 0.22), function()
		hallLabel.Visible = false
	end)
end

local function hallucination(kind)
	local types = CONFIG.Hallucination.Types
	if #types == 0 then return end
	kind = kind or types[math.random(1, #types)]
	if kind == "figure" then spawnFigure()
	elseif kind == "eyes" then spawnEyes()
	elseif kind == "text" then whisperText() end
end

local function updateHallucinations(dt, now)
	local fg = FXS.figure
	if fg then
		if not fg.head.Parent then
			clearFigure()
		else
			if onScreen(fg.head.Position) then fg.seenT += dt else fg.seenT = 0 end
			-- it vanishes the moment you look straight at it (or after a few seconds)
			if fg.seenT > 0.45 or now - fg.born > CONFIG.Hallucination.Lifetime then
				if fg.seenT > 0.45 then
					FX.shake(0.12)
					staticBurst = math.max(staticBurst, 0.5)
				end
				clearFigure()
			end
		end
	end
	local ey = FXS.eyes
	if ey then
		if now >= ey.blinkAt then
			ey.blinkUntil = now + 0.12
			ey.blinkAt = now + rr(0.6, 1.6)
		end
		local vis = now >= ey.blinkUntil
		for _, p in ipairs(ey.parts) do p.Transparency = vis and 0 or 1 end
		if onScreen(ey.pos) then ey.seenT += dt else ey.seenT = 0 end
		if ey.seenT > 0.6 or now - ey.born > 3.5 then
			clearEyes()
		end
	end
end

----------------------------------------------------------
-- 5. SCREEN GLITCHES: tint flashes, torn blocks, blackouts, jitter, the tracking bar
----------------------------------------------------------
local glitchBlocks = {}
for i = 1, 8 do
	glitchBlocks[i] = new("Frame", {BorderSizePixel = 0, Visible = false, ZIndex = 11}, gui)
end

local function glitchBurst(kind)
	local kinds = {"tint", "blocks", "blackout", "jitter", "bar"}
	kind = kind or kinds[math.random(1, #kinds)]
	if kind == "tint" then
		FXS.tintUntil = os.clock() + rr(0.08, 0.2)
		FXS.tint = (math.random() < 0.5) and Color3.fromRGB(90, 255, 255) or Color3.fromRGB(255, 80, 120)
	elseif kind == "blocks" then
		local vp = camera.ViewportSize
		for _, b in ipairs(glitchBlocks) do
			b.Visible = true
			b.Size = UDim2.fromOffset(math.random(60, 360), math.random(6, 40))
			b.Position = UDim2.fromOffset(math.random(0, math.max(1, math.floor(vp.X))), math.random(0, math.max(1, math.floor(vp.Y))))
			b.BackgroundColor3 = (math.random() < 0.5) and Color3.new(1, 1, 1) or Color3.fromRGB(40, 255, 255)
			b.BackgroundTransparency = 0.55 + math.random() * 0.3
		end
		task.delay(rr(0.06, 0.14), function()
			for _, b in ipairs(glitchBlocks) do b.Visible = false end
		end)
	elseif kind == "blackout" then
		if not killing and killFade.BackgroundTransparency > 0.99 then
			killFade.BackgroundTransparency = 0
			task.delay(rr(0.04, 0.09), function()
				if alive and not killing then killFade.BackgroundTransparency = 1 end
			end)
		end
	elseif kind == "jitter" then
		FX.shake(0.35)
		glitch = 1
	elseif kind == "bar" and FEAT.VHSOverlay then
		bar.Visible = true
		bar.Position = UDim2.new(0, 0, -0.05, 0)
		local dur = 0.5 + math.random() * 0.6
		TweenService:Create(bar, TweenInfo.new(dur, Enum.EasingStyle.Linear), {Position = UDim2.new(0, 0, 1.02, 0)}):Play()
		glitch = 1
		task.delay(dur, function() bar.Visible = false end)
	end
end

FX.glitch = glitchBurst
FX.tint = function()
	if FXS.tint and os.clock() < FXS.tintUntil then return FXS.tint end
	return nil
end

----------------------------------------------------------
-- 6. JUMPSCARES (non-lethal): a monster face in your face, a shape behind you, a flash
----------------------------------------------------------
local function clearGhost()
	if FXS.ghost then
		pcall(function() FXS.ghost.g.model:Destroy() end)
		FXS.ghost = nil
	end
end

local function spawnGhost(scale, distance, behind, life)
	if FXS.ghost then return end
	local flat = flatLook() or Vector3.new(0, 0, -1)
	local cf = camera.CFrame
	local g = buildMonster(scale)
	for _, d in ipairs(g.model:GetDescendants()) do
		if d:IsA("Sound") then d:Destroy() end
	end
	g.root.Anchored = true
	local dir = behind and -flat or flat
	local headUp = 6.55 * scale
	local pos = cf.Position + dir * distance
	local rootPos = Vector3.new(pos.X, cf.Position.Y - headUp, pos.Z)
	g.root.CFrame = CFrame.lookAt(rootPos, Vector3.new(cf.Position.X, rootPos.Y, cf.Position.Z))
	g.model.Parent = fxFolder
	local head = g.model:FindFirstChild("Head")
	if head then
		new("PointLight", {Color = Color3.fromRGB(255, 235, 220), Range = 14, Brightness = 3}, head, true)
	end
	FXS.ghost = {g = g, born = os.clock(), life = life, basePos = cf.Position, dir = dir, distance = distance, headUp = headUp}
end

local function updateGhost(dt, now)
	local gh = FXS.ghost
	if not gh then return end
	local u = (now - gh.born) / gh.life
	if u >= 1 or not gh.g.model.Parent then
		clearGhost()
		return
	end
	-- the face lunges a little toward the camera while its mouth is wide open
	local dist = gh.distance - 0.9 * u
	local pos = gh.basePos + gh.dir * dist
	local rootPos = Vector3.new(pos.X, gh.basePos.Y - gh.headUp, pos.Z)
	gh.g.root.CFrame = CFrame.lookAt(rootPos, Vector3.new(gh.basePos.X, rootPos.Y, gh.basePos.Z))
	gh.g.update(dt, 0, "strike", 1, false)
end

local function jumpscare(kind)
	if killing or FXS.ghost then return end
	local kinds = CONFIG.Jumpscare.Kinds
	if #kinds == 0 then return end
	kind = kind or kinds[math.random(1, #kinds)]
	if kind == "flash" then
		flash.BackgroundColor3 = Color3.new(1, 1, 1)
		flash.BackgroundTransparency = 0.05
		TweenService:Create(flash, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
		task.delay(0.4, function() flash.BackgroundColor3 = Color3.fromRGB(170, 0, 0) end)
		FX.shake(0.8)
		staticBurst = 1
		FX.sound("scare")
		glitchBurst("blocks")
	elseif kind == "face" then
		spawnGhost(1.5, 3.2, false, 0.65)
		FX.spotted()
		FX.shake(1)
	elseif kind == "behind" then
		spawnGhost(0.7, 4.0, true, 1.4)
		FX.shake(0.4)
		FX.sound("scare")
	end
end
FX.jumpscare = jumpscare

----------------------------------------------------------
-- scheduler: called every frame by the main loop
----------------------------------------------------------
FX.update = function(dt, now, monsterDist)
	FXS.monsterDist = monsterDist
	updateFlicker(dt, now)

	if FEAT.AmbientSounds and now >= FXS.nextAmbient then
		ambientEvent()
		FXS.nextAmbient = nextIn(CONFIG.Ambient.MinInterval, CONFIG.Ambient.MaxInterval)
	end

	if FEAT.FakeFootsteps then
		if not FXS.fake and now >= FXS.nextFake then
			startFakeFootsteps()
			FXS.nextFake = nextIn(CONFIG.FakeFootsteps.MinInterval, CONFIG.FakeFootsteps.MaxInterval)
		end
		updateFakeFootsteps(dt)
	end

	if FEAT.Hallucinations then
		if now >= FXS.nextHallu and not killing then
			hallucination()
			FXS.nextHallu = nextIn(CONFIG.Hallucination.MinInterval, CONFIG.Hallucination.MaxInterval)
		end
		updateHallucinations(dt, now)
	end

	if FEAT.ScreenGlitches and now >= FXS.nextGlitch and not killing then
		glitchBurst()
		FXS.nextGlitch = nextIn(CONFIG.Glitch.MinInterval, CONFIG.Glitch.MaxInterval)
	end

	if FEAT.Jumpscares and now >= FXS.nextScare and not killing then
		jumpscare()
		FXS.nextScare = nextIn(CONFIG.Jumpscare.MinInterval, CONFIG.Jumpscare.MaxInterval)
	end
	updateGhost(dt, now)
end

-- a failing FX system must never break the game: after 3 errors the FX layer is switched off
FX.disableAll = function()
	for _, k in ipairs({"Flicker", "AmbientSounds", "FakeFootsteps", "Hallucinations", "ScreenGlitches", "Jumpscares"}) do
		FEAT[k] = false
	end
	stopFakeFootsteps()
	clearFigure()
	clearEyes()
	clearGhost()
end


