local function pickupItem(kind)
	if kind == "flaregun" then
		hasFlareGun = true
		flares += 2
		updateFlareHud()
		showToast("Flare Gun and 2 flares  (G to fire)")
	elseif kind == "flares" then
		flares += 2
		updateFlareHud()
		showToast("+2 flares")
	elseif kind == "medkit" then
		medkits += 1
		showToast("Medkit added  [" .. CONFIG.MedkitHeal .. " HP]  (" .. CONFIG.MedkitKey.Name .. " to use)")
	elseif kind == "energy" then
		energies += 1
		showToast("Energy drink added  (" .. CONFIG.EnergyKey.Name .. " to drink)")
	end
	if not FEAT.Inventory then
		if kind == "medkit" then
			useMedkit()
		elseif kind == "energy" then
			useEnergy()
		end
	end
	refreshInventory()
	if pickSnd then pickSnd:Play() end
end

local function makeItem(kind, pos, parent)
	local info = ITEM_INFO[kind]
	local model = Instance.new("Model")
	model.Name = "Item_" .. kind
	local cf = CFrame.new(pos) * CFrame.Angles(0, math.random() * 6.28, 0)
	local main

	local function piece(size, off, color, material, shape)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.Size = size
		p.CFrame = cf * off
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		if shape then p.Shape = shape end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	if kind == "flaregun" then
		main = piece(Vector3.new(0.6, 0.7, 1.9), CFrame.new(0, 0.5, 0), Color3.fromRGB(220, 90, 25))
		piece(Vector3.new(0.5, 1.0, 0.55), CFrame.new(0, -0.05, 0.55) * CFrame.Angles(0.25, 0, 0), Color3.fromRGB(30, 30, 32))
		piece(Vector3.new(0.4, 0.4, 0.9), CFrame.new(0, 0.55, -1.2), Color3.fromRGB(120, 120, 125), Enum.Material.Metal)
	elseif kind == "flares" then
		for i = -1, 1 do
			local f = piece(Vector3.new(1.1, 0.35, 0.35), CFrame.new(0, 0.2, i * 0.45), Color3.fromRGB(200, 30, 25))
			piece(Vector3.new(0.2, 0.3, 0.3), CFrame.new(0.65, 0.2, i * 0.45), Color3.fromRGB(255, 140, 60), Enum.Material.Neon)
			main = main or f
		end
	elseif kind == "medkit" then
		main = piece(Vector3.new(1.8, 1.0, 1.2), CFrame.new(0, 0.5, 0), Color3.fromRGB(235, 235, 235))
		piece(Vector3.new(1.0, 0.06, 0.28), CFrame.new(0, 1.03, 0), Color3.fromRGB(200, 20, 20))
		piece(Vector3.new(0.28, 0.06, 1.0), CFrame.new(0, 1.03, 0), Color3.fromRGB(200, 20, 20))
	else
		main = piece(Vector3.new(1.3, 0.7, 0.7), CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(40, 200, 170), Enum.Material.Metal, Enum.PartType.Cylinder)
		piece(Vector3.new(0.12, 0.74, 0.74), CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(200, 200, 205), Enum.Material.Metal, Enum.PartType.Cylinder)
	end

	-- faint glow so the item can be found in the dark
	new("PointLight", {Color = info.color, Range = 7, Brightness = 0.8}, main, true)

	if Support.Prompts then
		local prompt = new("ProximityPrompt", {
			ActionText = "Take",
			ObjectText = info.label,
			HoldDuration = 0.2,
			MaxActivationDistance = 9,
			RequiresLineOfSight = false,
			KeyboardKeyCode = Enum.KeyCode.E,
		}, main)
		C(prompt.Triggered, function()
			pickupItem(kind)
			model:Destroy()
		end)
	else
		-- ProximityPrompts are unsupported here: items are picked up with [E] (see pickupNearest)
		table.insert(itemRegistry, {model = model, main = main, kind = kind})
	end

	model.PrimaryPart = main
	model.Parent = parent
	return model
end

pickupNearest = function()
	local tgt = getTarget()
	if not tgt then return end
	local bestIdx, bestDist
	for i, it in ipairs(itemRegistry) do
		if it.model.Parent then
			local d = (it.main.Position - tgt.hrp.Position).Magnitude
			if d < 9 and (not bestDist or d < bestDist) then
				bestIdx, bestDist = i, d
			end
		end
	end
	if bestIdx then
		local it = table.remove(itemRegistry, bestIdx)
		pickupItem(it.kind)
		it.model:Destroy()
	end
end

------------------------------------------------------------
-- MAP POINTS: monster and items work directly on the place's map
------------------------------------------------------------
local function randomMapPoint(minR, maxR, around)
	local tgt = getTarget()
	local c = around or (tgt and tgt.hrp.Position) or mapOrigin

	local ignore = {}
	if player.Character then table.insert(ignore, player.Character) end
	if currentMonster then table.insert(ignore, currentMonster.model) end
	if itemsFolder then table.insert(ignore, itemsFolder) end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignore

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = ignore

	for _ = 1, 30 do
		local a = math.random() * math.pi * 2
		local r = minR + math.random() * (maxR - minR)
		local x, z = c.X + math.cos(a) * r, c.Z + math.sin(a) * r
		-- the ray goes top-down from just above head height so it does not hit the roof
		local hit = workspace:Raycast(Vector3.new(x, c.Y + 6, z), Vector3.new(0, -80, 0), rayParams)
		if hit and hit.Normal.Y > 0.85 and hit.Instance.CanCollide and hit.Material ~= Enum.Material.Water then
			local pos = hit.Position
			-- there must be free space above the point (not inside a wall or furniture)
			local parts = workspace:GetPartBoundsInRadius(pos + Vector3.new(0, 5, 0), 3.5, overlap)
			if #parts == 0 then
				return pos
			end
		end
	end
	return nil
end

local function canReach(a, b)
	local path = PathfindingService:CreatePath({AgentRadius = 2.5, AgentHeight = 7, AgentCanJump = true})
	local ok = pcall(function()
		path:ComputeAsync(a, b)
	end)
	return ok and path.Status == Enum.PathStatus.Success
end

local function getMonsterSpawn()
	local tgt = getTarget()
	local c = tgt and tgt.hrp.Position or mapOrigin
	local first
	for _ = 1, 8 do
		local p = randomMapPoint(CONFIG.MonsterSpawnDistance * 0.7, CONFIG.MonsterSpawnDistance * 1.3, c)
		if p then
			first = first or p
			if canReach(c, p) then
				return p + Vector3.new(0, 9, 0)
			end
		end
	end
	return first and (first + Vector3.new(0, 9, 0)) or nil
end

local function spawnItems()
	itemsFolder = Instance.new("Folder")
	itemsFolder.Name = "HorrorItems"
	itemsFolder.Parent = workspace

	local pool = {"flares", "flares", "flares", "flares", "medkit", "medkit", "medkit", "energy", "energy", "energy", "flaregun"}
	local placed = {}

	local function farEnough(p, minDist)
		for _, q in ipairs(placed) do
			if (p - q).Magnitude < minDist then return false end
		end
		return true
	end

	-- places an item no closer than ItemMinDistance to the others
	-- (if space is tight, the requirement is halved near the end of the attempts)
	local function place(kind, minR, maxR)
		for attempt = 1, 40 do
			local minDist = attempt <= 30 and CONFIG.ItemMinDistance or CONFIG.ItemMinDistance * 0.5
			local p = randomMapPoint(minR, maxR, mapOrigin)
			if p and farEnough(p, minDist) then
				table.insert(placed, p)
				makeItem(kind, p + Vector3.new(0, 0.05, 0), itemsFolder)
				return true
			end
		end
		return false
	end

	-- the Flare Gun and flares are guaranteed, but not right next to each other
	place("flaregun", 20, 60)
	place("flares", 40, 110)

	for _ = 1, CONFIG.ItemsOnMap do
		place(pool[math.random(1, #pool)], 15, CONFIG.ItemRadius)
	end
end

------------------------------------------------------------
-- FX SYSTEMS (client-side visuals and audio only; they never change gameplay state)
--   flashlight flicker, creepy ambient sounds, fake footsteps, hallucinations,
--   screen glitches and jumpscares. Each one has a switch in CONFIG.Features.
------------------------------------------------------------
local fxFolder = Instance.new("Folder")
fxFolder.Name = "HorrorFX"
fxFolder.Parent = workspace

local function rr(a, b) return a + math.random() * (b - a) end

-- next event time; events come more often as the difficulty rises
local function nextIn(minV, maxV)
	return os.clock() + rr(minV, maxV) / math.max(Diff.get("Scares"), 0.1)
end

local FXS = {
	monsterDist = math.huge,
	flick = {queue = nil, idx = 1, t = 0, off = false, dim = 1, nextAt = nextIn(CONFIG.Flicker.MinInterval, CONFIG.Flicker.MaxInterval)},
	nextAmbient = nextIn(CONFIG.Ambient.MinInterval, CONFIG.Ambient.MaxInterval),
	nextFake = nextIn(CONFIG.FakeFootsteps.MinInterval, CONFIG.FakeFootsteps.MaxInterval),
	nextHallu = nextIn(CONFIG.Hallucination.MinInterval, CONFIG.Hallucination.MaxInterval),
	nextGlitch = nextIn(CONFIG.Glitch.MinInterval, CONFIG.Glitch.MaxInterval),
	nextScare = nextIn(CONFIG.Jumpscare.MinInterval, CONFIG.Jumpscare.MaxInterval),
	fake = nil, figure = nil, eyes = nil, ghost = nil,
	tint = nil, tintUntil = 0,
	failures = 0,
}

-- ground point under (x, z), ignoring the player and FX objects
local function groundPoint(x, z, refY)
	local ignore = {fxFolder}
	if player.Character then table.insert(ignore, player.Character) end
	if itemsFolder then table.insert(ignore, itemsFolder) end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(Vector3.new(x, refY + 6, z), Vector3.new(0, -80, 0), params)
	if hit and hit.Normal.Y > 0.8 and hit.Material ~= Enum.Material.Water then return hit.Position end
	return nil
end

local function flatLook()
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then return nil end
	return flat.Unit
end

local function onScreen(point)
	local _, on = camera:WorldToViewportPoint(point)
	return on
end

----------------------------------------------------------
-- 1. FLASHLIGHT FLICKER: random blink patterns, plus dimming when the monster is near
----------------------------------------------------------
local function startFlickerPattern()
	local q = {}
	for _ = 1, math.random(2, 5) do
		table.insert(q, 0.03 + math.random() * 0.1)   -- dark
		table.insert(q, 0.04 + math.random() * 0.14)  -- light
	end
	if math.random() < 0.35 then
		table.insert(q, 0.4 + math.random() * 0.45)   -- a long dark moment
	end
	FXS.flick.queue, FXS.flick.idx, FXS.flick.t = q, 1, 0
end

local function updateFlicker(dt, now)
	local f = FXS.flick
	if FEAT.Flicker and not f.queue and now >= f.nextAt then
		startFlickerPattern()
	end
	if f.queue then
		f.t += dt
		local dur = f.queue[f.idx]
		if f.t >= dur then
			f.t -= dur
			f.idx += 1
			if f.idx > #f.queue then
				f.queue = nil
				f.nextAt = nextIn(CONFIG.Flicker.MinInterval, CONFIG.Flicker.MaxInterval)
			end
		end
		f.off = f.queue ~= nil and (f.idx % 2 == 1)
	else
		f.off = false
	end
	local targetDim = 1
	if FEAT.Flicker and FXS.monsterDist < 45 then
		targetDim = 1 - CONFIG.Flicker.DimAmount * (1 - FXS.monsterDist / 45)
	end
	f.dim += (targetDim - f.dim) * math.min(dt * 4, 1)
end

FX.flickerOff = function() return FXS.flick.off end
FX.flickerDim = function() return FXS.flick.dim end

----------------------------------------------------------
-- 2. CREEPY AMBIENT SOUNDS: one-shot sounds from random places around you
----------------------------------------------------------
local function ambientEvent()
	local list = CONFIG.AmbientEvents
	if #list == 0 then return end
	local ev = list[math.random(1, #list)]
	local tgt = getTarget()
	if not tgt then return end
	local ang = math.random() * math.pi * 2
	local r = rr(CONFIG.Ambient.Radius[1], CONFIG.Ambient.Radius[2])
	local pos = tgt.hrp.Position + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
	local part = new("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
		Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(pos),
	}, fxFolder)
	local snd = makeSound(part, ev.id, {
		Volume = ev.volume * CONFIG.Ambient.Volume, PlaybackSpeed = ev.speed,
		RollOffMode = Enum.RollOffMode.InverseTapered, RollOffMinDistance = 8, RollOffMaxDistance = 150,
	})
	if not snd then
		part:Destroy()
		return
	end
	addReverb(snd, -2)
	if ev.distortion then addDistortion(snd, ev.distortion) end
	snd:Play()
	Debris:AddItem(part, 10)
end

----------------------------------------------------------
-- 3. FAKE FOOTSTEPS: steps that creep up behind you; they stop dead when you turn around
----------------------------------------------------------
local function stopFakeFootsteps()
	local f = FXS.fake
	if f then
		pcall(function() f.part:Destroy() end)
		FXS.fake = nil
	end
end

local function startFakeFootsteps()
	if FXS.fake or CONFIG.Sounds.Walk == "" then return end
	local tgt = getTarget()
	local flat = flatLook()
	if not tgt or not flat then return end
	local side = Vector3.new(-flat.Z, 0, flat.X) * (math.random() < 0.5 and 1 or -1) * rr(2, 6)
	local part = new("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
		Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(tgt.hrp.Position - flat * 28),
	}, fxFolder)
	local snd = makeSound(part, CONFIG.Sounds.Walk, {
		Looped = true, Volume = 0, PlaybackSpeed = 0.8,
		RollOffMode = Enum.RollOffMode.InverseTapered, RollOffMinDistance = 6, RollOffMaxDistance = 90,
	})
	if not snd then
		part:Destroy()
		return
	end
	addReverb(snd, -4)
	snd:Play()
	FXS.fake = {part = part, snd = snd, t = 0, side = side, startBack = rr(24, 32), endBack = rr(7, 10)}
end

local function updateFakeFootsteps(dt)
	local f = FXS.fake
	if not f then return end
	local tgt = getTarget()
	local flat = flatLook()
	if not tgt or not flat or not f.part.Parent then
		stopFakeFootsteps()
		return
	end
	f.t += dt
	local dur = CONFIG.FakeFootsteps.Duration
	local u = math.clamp(f.t / dur, 0, 1)
	local back = f.startBack + (f.endBack - f.startBack) * u
	local pos = tgt.hrp.Position - flat * back + f.side * (1 - u)
	f.part.CFrame = CFrame.new(pos)
	f.snd.Volume = CONFIG.FakeFootsteps.Volume * (0.25 + 0.75 * u)
	f.snd.PlaybackSpeed = 0.75 + u * 0.1

	local toPart = pos - tgt.hrp.Position
	local facing = toPart.Magnitude > 0.1 and flat:Dot(toPart.Unit) > 0.55
	if facing or f.t >= dur then
		stopFakeFootsteps()
	end
end

