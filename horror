-- LOBBY (hub): the monster stands in the center, the forest is behind it.
-- Buttons: PLAY (starts the game) and STOP (stops the script and deletes it).
-- Version and the feature list are shown in the right corner.
------------------------------------------------------------
local FEATURE_ORDER = {"VHSOverlay", "FlashlightFX", "Flicker", "AmbientSounds", "Hallucinations", "FakeFootsteps", "ScreenGlitches",
	"CameraShake", "Jumpscares", "KillAnimations", "AdaptiveSpeed", "Difficulty", "Stalking", "SilentBehind",
	"CrawlAnimation", "Decoy", "Teleport", "Items", "FlareGun", "Inventory", "PlayerFootsteps", "Heartbeat", "Sprint", "PlayerCrawl"}

local FEATURE_LABELS = {
