------------------------------------------------------------
-- RUNTIME HELPERS
------------------------------------------------------------
local Runtime = {sounds = setmetatable({}, {__mode = "v"}), soundCount = 0}

local function new(class, props, parent, keep)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if keep then o:SetAttribute("HorrorKeep", true) end
	o.Parent = parent
	return o
end

-- like new(), but returns an inert table if the instance cannot be created (graceful fallback)
local function safeNew(class, props, parent, keep)
	local ok, o = pcall(new, class, props, parent, keep)
	if ok then return o end
	return {}
end

------------------------------------------------------------
-- SUPPORT: probe what this game allows and disable what it does not
------------------------------------------------------------
local Support = {Sound = true, Raycast = true, PostEffects = true, Pathfinding = true, Prompts = true, Camera = true}
do
	local function probe(name, fn)
		local ok, res = pcall(fn)
		if not ok or res == false then Support[name] = false end
	end
	probe("Sound", function() Instance.new("Sound"):Destroy() return true end)
	probe("PostEffects", function()
		Instance.new("ColorCorrectionEffect"):Destroy()
		Instance.new("BlurEffect"):Destroy()
		return true
	end)
	probe("Raycast", function() return typeof(workspace.Raycast) == "function" end)
	probe("Pathfinding", function() return PathfindingService:CreatePath({AgentRadius = 2.5}) ~= nil end)
	probe("Prompts", function() return ProximityPromptService.Enabled end)
	probe("Camera", function() return workspace.CurrentCamera ~= nil end)
end

if not Support.Camera then
	warn("[HorrorMode] No camera available in this game - script stopped.")
	return
end

-- FEAT = the switches from CONFIG.Features minus everything this game cannot support
local FEAT = {}
local FEAT_NA = {} -- feature -> reason it was turned off automatically
for k, v in pairs(CONFIG.Features) do FEAT[k] = v end
do
	local function disable(keys, why)
		for _, k in ipairs(keys) do
			if FEAT[k] then
				FEAT[k] = false
				FEAT_NA[k] = why
			end
		end
	end
	if not Support.Sound then
		disable({"AmbientSounds", "FakeFootsteps", "PlayerFootsteps", "Heartbeat"}, "no audio")
	end
	if not Support.Raycast then
		disable({"Items", "Decoy", "Teleport", "Hallucinations", "Jumpscares"}, "no raycasting")
	end
end
do
	local off = {}
	for k, why in pairs(FEAT_NA) do table.insert(off, k .. " (" .. why .. ")") end
	if not Support.Pathfinding then table.insert(off, "Pathfinding (monster moves directly)") end
	if not Support.Prompts then table.insert(off, "ProximityPrompts (pick up items with [E])") end
	if not Support.PostEffects then table.insert(off, "PostEffects (no color grading/blur)") end
	if #off > 0 then print("[HorrorMode] Unsupported here, using fallbacks: " .. table.concat(off, ", ")) end
end

function Runtime.makeSound(parent, id, props)
	if not Support.Sound or not id or id == "" then return nil end
	local ok, s = pcall(function()
		local snd = Instance.new("Sound")
		snd.SoundId = id
		for k, v in pairs(props or {}) do snd[k] = v end
		snd.Parent = parent
		return snd
	end)
	if not ok then return nil end
	Runtime.soundCount += 1
	Runtime.sounds[Runtime.soundCount] = s
	return s
end
local makeSound = Runtime.makeSound

local function addReverb(sound, wet)
	if not sound then return end
	pcall(function()
		local r = Instance.new("ReverbSoundEffect")
		r.DecayTime = 3
		r.Density = 1
		r.Diffusion = 1
		r.DryLevel = -2
		r.WetLevel = wet or -6
		r.Parent = sound
	end)
end

local function addDistortion(sound, level)
	if not sound then return end
	pcall(function()
		local d = Instance.new("DistortionSoundEffect")
		d.Level = level
		d.Parent = sound
	end)
end

------------------------------------------------------------
-- LIGHTING HELPERS (snapshot / restore, stash the game's own sky and effects)
------------------------------------------------------------
local LIGHT_PROPS = {"ClockTime", "Brightness", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom",
	"GlobalShadows", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "FogColor", "FogStart", "FogEnd"}

local function snapshotLighting()
	local t = {}
	for _, k in ipairs(LIGHT_PROPS) do
		pcall(function() t[k] = Lighting[k] end)
	end
	return t
end

local function restoreLighting(t)
	for k, v in pairs(t) do
		pcall(function() Lighting[k] = v end)
	end
end

-- the game's own Sky / Atmosphere / post effects are moved out of Lighting (not destroyed) and put back later
local function stashLightingObjects()
	local list = {}
	for _, c in ipairs(Lighting:GetChildren()) do
		if (c:IsA("Sky") or c:IsA("Atmosphere") or c:IsA("PostEffect")) and not c:GetAttribute("HorrorKeep") then
			table.insert(list, c)
			c.Parent = nil
		end
	end
	return list
end

local function unstashLightingObjects(list)
	for _, c in ipairs(list) do
		pcall(function() c.Parent = Lighting end)
	end
end


local function buildMonster(scale)
	local S = scale or CONFIG.MonsterScale
	local maroon = Color3.fromRGB(66, 40, 44)
	local maroonLight = Color3.fromRGB(88, 58, 58)
	local darkBody = Color3.fromRGB(38, 29, 33)
	local black = Color3.fromRGB(13, 10, 12)
	local skinFace = Color3.fromRGB(231, 203, 193)
	local skinNose = Color3.fromRGB(214, 176, 166)
	local lipRed = Color3.fromRGB(92, 28, 38)
	local eyeRim = Color3.fromRGB(238, 230, 222)
	local eyeColor = CONFIG.MonsterEyeColor
	local eyeDim = Color3.fromRGB(70, 12, 10)

	local model = Instance.new("Model")
	model.Name = "HorrorMonster"

	local function V(x, y, z) return Vector3.new(x, y, z) * S end
	local function C(x, y, z) return CFrame.new(x * S, y * S, z * S) end

	local function part(name, sx, sy, sz, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = V(sx, sy, sz)
		p.Color = color
		p.Material = material or Enum.Material.Slate
		if shape then p.Shape = shape end
		p.CanCollide = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local function joint(p0, p1, c0, c1)
		local m = Instance.new("Motor6D")
		m.Name = p1.Name
		m.Part0 = p0
		m.Part1 = p1
		m.C0 = c0
		m.C1 = c1 or CFrame.new()
		m.Parent = p0
		return m
	end

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = V(2, 2, 1)
	root.Transparency = 1
	root.CanCollide = true
	root.Parent = model

	-- pelvis, narrow abdomen, narrow ribcage
	local pelvis = part("Pelvis", 1.6, 0.8, 0.8, darkBody)
	joint(root, pelvis, C(0, -0.3, 0))

	local abdomen = part("Abdomen", 0.9, 1.4, 0.7, darkBody)
	local abdBase = C(0, 0.4, 0) * CFrame.Angles(-0.06, 0, 0)
	local jAbd = joint(root, abdomen, abdBase, C(0, -0.7, 0))

	local chest = part("Chest", 1.8, 2.2, 0.95, darkBody)
	local chestBase = C(0, 0.7, 0) * CFrame.Angles(-0.06, 0, 0)
	local jChest = joint(abdomen, chest, chestBase, C(0, -1.1, 0))

	local shoulderBar = part("ShoulderBar", 2.9, 0.35, 0.6, black)
	joint(chest, shoulderBar, C(0, 0.95, 0))

	for i = 1, 6 do
		local v = part("Spine", 0.2, 0.2, 0.2, black)
		joint(chest, v, C(0, -0.9 + (i - 1) * 0.38, 0.52))
	end
	for i = 1, 3 do
		local v = part("Spine", 0.18, 0.18, 0.18, black)
		joint(abdomen, v, C(0, -0.4 + (i - 1) * 0.4, 0.4))
	end

	-- black hook-claws at the waist
	for _, side in ipairs({-1, 1}) do
		for k = 0, 1 do
			local claw = part("WaistClaw", 0.12, 1.1, 0.12, black)
			joint(abdomen, claw, C(side * (0.25 + k * 0.12), -0.1, -0.42) * CFrame.Angles(0.5, 0, side * (0.5 + k * 0.35)), C(0, 0.55, 0))
		end
	end

	-- long thin neck with wire rings
	local neck = part("Neck", 0.35, 1.6, 0.35, black)
	local neckBase = C(0, 1.1, 0) * CFrame.Angles(0.1, 0, 0)
	local jNeck = joint(chest, neck, neckBase, C(0, -0.8, 0))
	for i = 1, 4 do
		local ring = part("NeckRing", 0.1, 0.75, 0.75, black, Enum.Material.Metal, Enum.PartType.Cylinder)
		joint(neck, ring, C(0, -0.6 + (i - 1) * 0.4, 0) * CFrame.Angles(0, 0, math.rad(90)))
	end

	----------------------------------------------------------
	-- HEAD: long flat pale face, long nose, huge black
	-- round eye sockets, small dark-red mouth, wild black hair
	----------------------------------------------------------
	local head = part("Head", 1.0, 1.9, 0.75, skinFace, Enum.Material.SmoothPlastic)
	local headBase = C(0, 0.8, 0) * CFrame.Angles(-0.04, 0, 0)
	local jHead = joint(neck, head, headBase, C(0, -0.95, 0.05))

	-- long nose
	local nose = part("Nose", 0.3, 0.95, 0.35, skinNose, Enum.Material.SmoothPlastic)
	joint(head, nose, C(0, -0.05, -0.5))
	local noseTip = part("NoseTip", 0.42, 0.28, 0.3, skinNose, Enum.Material.SmoothPlastic)
	joint(head, noseTip, C(0, -0.5, -0.55))
	local brow = part("Brow", 0.95, 0.16, 0.22, skinNose, Enum.Material.SmoothPlastic)
	joint(head, brow, C(0, 0.58, -0.4))

	-- round black eye sockets with a white rim; a tiny glowing pupil in the center
	local eyes = {}
	for _, side in ipairs({-1, 1}) do
		local rim = part("EyeRim", 0.1, 0.52, 0.52, eyeRim, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		joint(head, rim, C(side * 0.26, 0.35, -0.375) * CFrame.Angles(0, math.rad(90), 0))
		local hole = part("EyeHole", 0.1, 0.38, 0.38, Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		joint(head, hole, C(side * 0.26, 0.35, -0.395) * CFrame.Angles(0, math.rad(90), 0))
		local eye = part("Eye", 0.13, 0.13, 0.13, eyeColor, Enum.Material.Neon, Enum.PartType.Ball)
		joint(head, eye, C(side * 0.26, 0.35, -0.43))
		table.insert(eyes, eye)
	end

	-- mouth: dark cavity in the head, movable jaw with dark-red lips
	local mouthHole = part("MouthHole", 0.5, 0.3, 0.1, black)
	joint(head, mouthHole, C(0, -0.58, -0.37))

	local jaw = part("Jaw", 0.9, 0.55, 0.65, skinFace, Enum.Material.SmoothPlastic)
	local jawBase = C(0, -0.75, 0.28)
	local jJaw = joint(head, jaw, jawBase, C(0, 0.15, 0.3))
	local lips = part("Lips", 0.6, 0.22, 0.12, lipRed, Enum.Material.SmoothPlastic)
	joint(jaw, lips, C(0, 0.22, -0.33))
	local mouthIn = part("MouthIn", 0.42, 0.1, 0.1, black)
	joint(jaw, mouthIn, C(0, 0.22, -0.37))

	-- hair: dark cap, locks at the sides and back, wire curls and long strands
	local hairTop = part("HairTop", 1.3, 0.6, 1.1, black)
	joint(head, hairTop, C(0, 1.0, 0.05))
	local hairBack = part("HairBack", 1.3, 1.9, 0.5, black)
	joint(head, hairBack, C(0, 0.1, 0.55))
	for _, side in ipairs({-1, 1}) do
		local sideHair = part("HairSide", 0.45, 1.9, 0.8, black)
		joint(head, sideHair, C(side * 0.74, 0.05, 0.1))
	end
	for i = 1, 10 do
		local side = (i % 2 == 0) and 1 or -1
		local x = side * (0.62 + (i % 3) * 0.12)
		local y = -0.7 + (i * 0.17) % 1.7
		local z = -0.05 + (i * 0.31) % 0.5
		local curl = part("HairCurl", 0.08, 0.55, 0.55, black, Enum.Material.Metal, Enum.PartType.Cylinder)
		joint(head, curl, C(x, y, z) * CFrame.Angles(i * 0.7, i * 1.3, i * 0.5))
	end
	local strands = {}
	for _, side in ipairs({-1, 1}) do
		for j = 0, 2 do
			local strand = part("HairStrand", 0.12, 2.6, 0.12, black)
			local base = C(side * (0.66 + j * 0.08), 0.5 - j * 0.45, 0.25) * CFrame.Angles(0, 0, side * 0.08)
			local sj = joint(head, strand, base, C(0, 1.3, 0))
			table.insert(strands, {joint = sj, base = base, seed = side * 2 + j})
		end
	end

	-- arms: thin upper arm, elbow, long forearm ending in a black spike at the ground
	local arms = {}
	for _, side in ipairs({-1, 1}) do
		local upper = part(side < 0 and "UpperArmL" or "UpperArmR", 0.42, 4.0, 0.42, maroon)
		local shPos = C(side * 1.05, 0.95, 0)
		local jSh = joint(chest, upper, shPos * CFrame.Angles(0, 0, side * 0.55), C(0, 2.0, 0))

		local elbow = part("Elbow", 0.7, 0.7, 0.7, black, Enum.Material.Metal, Enum.PartType.Ball)
		joint(upper, elbow, C(0, -2.0, 0))

		local fore = part(side < 0 and "ForeArmL" or "ForeArmR", 0.6, 4.6, 0.6, maroonLight)
		local elPos = C(0, -2.0, 0)
		local jEl = joint(upper, fore, elPos * CFrame.Angles(0, 0, -side * 0.6), C(0, 2.3, 0))

		local lens = {2.0, 1.9, 2.0}
		local widths = {0.4, 0.26, 0.14}
		local cursor = -2.3
		for i = 1, 3 do
			local sp = part("ArmSpike", widths[i], lens[i], widths[i], black)
			joint(fore, sp, C(0, cursor - lens[i] / 2, 0))
			cursor -= lens[i]
		end

		arms[side] = {sh = jSh, shPos = shPos, el = jEl, elPos = elPos}
	end

	-- legs: thin thigh, thick shin, long spike instead of a foot
	local legs = {}
	for _, side in ipairs({-1, 1}) do
		local thigh = part(side < 0 and "ThighL" or "ThighR", 0.5, 3.8, 0.5, maroon)
		local hipPos = C(side * 0.65, -0.55, 0)
		local jHip = joint(root, thigh, hipPos * CFrame.Angles(0.05, 0, side * 0.12), C(0, 1.9, 0))

		local knee = part("Knee", 0.8, 0.8, 0.8, black, Enum.Material.Metal, Enum.PartType.Ball)
		joint(thigh, knee, C(0, -1.9, 0))

		local shin = part(side < 0 and "ShinL" or "ShinR", 0.85, 2.2, 0.85, maroonLight)
		local kneePos = C(0, -1.9, 0)
		local jKnee = joint(thigh, shin, kneePos * CFrame.Angles(-0.12, 0, -side * 0.12), C(0, 1.1, 0))

		local lens = {1.0, 1.3, 1.3}
		local widths = {0.5, 0.3, 0.14}
		local cursor = -1.1
		for i = 1, 3 do
			local sp = part("LegSpike", widths[i], lens[i], widths[i], black)
			joint(shin, sp, C(0, cursor - lens[i] / 2, 0))
			cursor -= lens[i]
		end

		legs[side] = {hip = jHip, hipPos = hipPos, knee = jKnee, kneePos = kneePos}
	end

	local STAND_HIP = 9.1   -- hip height above the ground (model units), standing
	local CROUCH_HIP = 5.2  -- crouched

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = STAND_HIP * S
	humanoid.WalkSpeed = CONFIG.MonsterWanderSpeed
	humanoid.MaxHealth = 1e9
	humanoid.Health = 1e9
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = model

	model.PrimaryPart = root

	-- monster sounds (3D)
	local function s3d(id, extra)
		local props = {
			RollOffMode = Enum.RollOffMode.InverseTapered,
			RollOffMinDistance = 10,
			RollOffMaxDistance = 160,
		}
		for k, v in pairs(extra) do props[k] = v end
		return makeSound(root, id, props)
	end

	local rumble = s3d(CONFIG.Sounds.Rumble, {Looped = true, Volume = 1.5, PlaybackSpeed = 0.25})
	addReverb(rumble, -4)
	if rumble then rumble:Play() end

	local steps = s3d(CONFIG.Sounds.Steps, {Looped = true, Volume = 2.5, PlaybackSpeed = 0.5})
	local roar = s3d(CONFIG.Sounds.Roar, {Volume = 3, PlaybackSpeed = 0.3, RollOffMaxDistance = 250})
	addDistortion(roar, 0.45)
	addReverb(roar, -2)
	local hit = s3d(CONFIG.Sounds.Hit, {Volume = 2, PlaybackSpeed = 0.7})

	----------------------------------------------------------
	-- ANIMATION: walk, CRAWL on legs and arms (chasing), crouch-creep (stalking), stun, emerge
	----------------------------------------------------------
	local t, phase = 0, 0
	local eyesBright = true
	local runK, crawlK, crouchK = 0, 0, 0
	local lastHip = STAND_HIP
	local CRAWL_HIP = 4.9      -- hip height while crawling (torso almost horizontal, limbs on the ground)
	local silent = false
	local rumbleBase = rumble and rumble.Volume or 0
	local useCrawl = CONFIG.Features.CrawlAnimation

	local function setSilent(v)
		silent = v and true or false
	end

	local function update(dt, speed, state, attackT, stunned)
		t += dt
		local chasing = (state == "chase" or state == "strike" or state == "kill")
		local moving = speed > 5
		local crawling = chasing and moving and useCrawl and not stunned
		local running = chasing and moving and (not useCrawl) and speed > 12
		local crouching = (state == "stalk" or state == "emerge") and not stunned

		-- smooth blending between the poses
		crawlK += ((crawling and 1 or 0) - crawlK) * math.min(dt * 7, 1)
		runK += ((running and 1 or 0) - runK) * math.min(dt * 8, 1)
		crouchK += ((crouching and 1 or 0) - crouchK) * math.min(dt * 6, 1)

		local k = math.clamp(speed / CONFIG.MonsterChaseSpeed, 0, 1.3)
		phase += dt * speed * (0.28 + 0.2 * runK + 0.17 * crawlK + 0.1 * crouchK)
		local sw = math.sin(phase)
		local stride = 0.5 + 0.45 * runK - 0.1 * crawlK - 0.15 * crouchK

		-- legs: when crawling the thighs point forward and the shins fold back (spider-like hind legs)
		local splay = 0.12 + 0.2 * crawlK
		for _, side in ipairs({-1, 1}) do
			local L = legs[side]
			local ph = phase + (side < 0 and 0 or math.pi)
			local hipX = 0.05 + (1.0 - 0.05) * crouchK + (1.1 - 0.05) * crawlK + math.sin(ph) * stride * k
			local kneeX = -0.12 + (-1.9 + 0.12) * crouchK + (-2.0 + 0.12) * crawlK
				- math.max(0, math.cos(ph)) * (0.6 + 0.6 * runK + 0.2 * crawlK) * k
			L.hip.C0 = L.hipPos * CFrame.Angles(hipX, 0, side * splay)
			L.knee.C0 = L.kneePos * CFrame.Angles(kneeX, 0, -side * splay)
		end

		-- hip height: crouching and crawling lower the monster to the ground
		local hipH = STAND_HIP + (CROUCH_HIP - STAND_HIP) * crouchK + (CRAWL_HIP - STAND_HIP) * crawlK
		if math.abs(hipH - lastHip) > 0.01 then
			lastHip = hipH
			humanoid.HipHeight = hipH * S
		end

		-- arms: hang to the ground; when crawling they reach far forward and claw the ground in a
		-- diagonal gait (left arm with right leg); in a crouch they brace forward like an animal
		for _, side in ipairs({-1, 1}) do
			local A = arms[side]
			local phA = phase + (side < 0 and math.pi or 0)
			local swingX = math.sin(phA) * (0.3 + 0.7 * runK + 0.15 * crawlK) * k
			local spread, elbowX = 0.55, 0
			if chasing then
				swingX += 0.25 * (1 - crawlK)
				spread = 0.8 + 0.2 * runK
				elbowX = 0.5 * runK
			end
			swingX += 0.9 * crouchK + 2.25 * crawlK
			spread += (0.3 - spread) * crawlK
			elbowX += (0.15 + math.max(0, math.cos(phA)) * 0.5 * k) * crawlK
			if attackT > 0 then
				swingX = 1.3 + 0.95 * crawlK
				spread = 0.3
				elbowX = 0.3
			end
			if stunned then
				swingX = 2.1 + math.sin(t * 30) * 0.08
				spread = 0.3
				elbowX = 1.4
			end
			if state == "emerge" then
				swingX = 2.6 + math.sin(t * 9 + side) * 0.35
				spread = 0.25
				elbowX = 0.8 + math.sin(t * 7) * 0.3
			end
			swingX += math.sin(t * 0.8 + side) * 0.04
			A.sh.C0 = A.shPos * CFrame.Angles(swingX, 0, side * spread)
			A.el.C0 = A.elPos * CFrame.Angles(elbowX, 0, -side * (spread + 0.05))
		end

		-- torso: leans far forward when crawling; the neck and head tilt back up to watch the target
		local abdLean = 0.2 * runK + 0.3 * crouchK + 0.45 * crawlK
		local chestLean = 0.3 * runK + 0.45 * crouchK + 0.75 * crawlK
		jAbd.C0 = abdBase * CFrame.Angles(-abdLean + math.sin(t * 1.5) * 0.02, sw * (0.08 + 0.12 * crawlK) * k, 0)
		jChest.C0 = chestBase * CFrame.Angles(-chestLean + math.sin(t * 1.5 + 1) * 0.02, sw * (0.1 + 0.1 * runK) * k, 0)
		jNeck.C0 = neckBase * CFrame.Angles(0.2 * runK + 0.4 * crouchK + 0.65 * crawlK + math.sin(t * 0.9) * 0.05, 0, math.sin(t * 0.5) * 0.05)

		local twitch = (chasing and math.sin(t * 23) * 0.06 or 0)
			+ (stunned and math.sin(t * 32) * 0.3 or 0)
			+ (state == "emerge" and math.sin(t * 27) * 0.25 or 0)
		jHead.C0 = headBase * CFrame.Angles(0.2 * runK + 0.4 * crouchK + 0.45 * crawlK, math.sin(t * 1.1) * 0.12 + twitch, math.sin(t * 0.6) * 0.14)

		-- mouth
		local open
		if attackT > 0 or stunned or state == "emerge" then
			open = -0.9
		elseif chasing then
			open = -0.3 - 0.25 * math.sin(t * 14)
		else
			open = -0.02 - 0.03 * math.sin(t * 2)
		end
		jJaw.C0 = jawBase * CFrame.Angles(open, 0, 0)

		-- hair sways and streams back when moving fast
		for _, st in ipairs(strands) do
			st.joint.C0 = st.base * CFrame.Angles(
				math.sin(t * 1.3 + st.seed) * 0.12 + sw * 0.15 * k - 0.3 * (runK + crawlK),
				0,
				math.sin(t * 0.9 + st.seed * 2) * 0.1)
		end

		-- eyes flicker when stunned
		local bright = (not stunned) or math.sin(t * 35) > 0
		if bright ~= eyesBright then
			eyesBright = bright
			for _, e in ipairs(eyes) do
				e.Color = bright and eyeColor or eyeDim
			end
		end

		-- sounds: footsteps and rumble are muted while the monster is silent (behind you)
		local vol = silent and 0 or 1
		if steps then
			local want = speed > 3
			if steps.Playing ~= want then steps.Playing = want end
			steps.PlaybackSpeed = 0.4 + speed / 70
			steps.Volume = 2.5 * (1 - 0.75 * crouchK) * (1 + 0.3 * crawlK) * vol
		end
		if rumble then rumble.Volume = rumbleBase * vol end
	end

	return {
		model = model,
		humanoid = humanoid,
		root = root,
		update = update,
		setSilent = setSilent,
		roar = roar,
		hit = hit,
	}
end


