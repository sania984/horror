local function setInventory(open)
	if killing then open = false end
	if open == invOpen then return end
	invOpen = open
	invPanel.Visible = open
	refreshInventory()
	if open then
		if invOpenSnd then invOpenSnd:Play() end
	else
		if invCloseSnd then invCloseSnd:Play() end
	end
end

useMedkit = function()
	if killing then return end
	if medkits <= 0 then
		showToast("No medkits")
		return
	end
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	if hum.Health >= hum.MaxHealth then
		showToast("Health is already full")
		return
	end
	medkits -= 1
	hum.Health = math.min(hum.MaxHealth, hum.Health + CONFIG.MedkitHeal)
	if pickSnd then pickSnd:Play() end
