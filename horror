local ITEM_INFO = {
	flaregun = {label = "Flare Gun", color = Color3.fromRGB(255, 120, 40)},
	flares   = {label = "Flares x2", color = Color3.fromRGB(255, 60, 40)},
	medkit   = {label = "Medkit", color = Color3.fromRGB(255, 255, 255)},
