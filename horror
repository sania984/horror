-- FLARE GUN
------------------------------------------------------------
local lastFlare = 0
fireFlare = function()
	local now = os.clock()
	if killing or not FEAT.FlareGun then return end
	if not hasFlareGun then return end
	if flares <= 0 then
		showToast("No flares")
		return
	end
	if now - lastFlare < CONFIG.FlareReload then return end
	lastFlare = now
	flares -= 1
	updateFlareHud()
	if shotSnd then shotSnd:Play() end

	local cam = camera.CFrame
	local pos = cam.Position + cam.LookVector * 2
	local vel = cam.LookVector * 170

	local ball = new("Part", {
		Name = "HorrorFlare",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.7, 0.7, 0.7),
		Color = Color3.fromRGB(255, 60, 30),
		Material = Enum.Material.Neon,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.new(pos),
	}, nil, true)
	local light = new("PointLight", {Color = Color3.fromRGB(255, 70, 40), Range = 45, Brightness = 5}, ball, true)
	new("ParticleEmitter", {
		Color = ColorSequence.new(Color3.fromRGB(255, 130, 50)),
		Rate = 60,
		Lifetime = NumberRange.new(0.4, 0.9),
		Speed = NumberRange.new(2, 6),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new(0.35, 0),
		LightEmission = 1,
	}, ball, true)
	ball.Parent = workspace

	local flightTime = 0
	local conn
	conn = C(RunService.Heartbeat, function(dt)
		flightTime += dt
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore = {ball, lightPart}
		if player.Character then table.insert(ignore, player.Character) end
		params.FilterDescendantsInstances = ignore

		vel += Vector3.new(0, -35 * dt, 0)
		local step = vel * dt
		local hit = workspace:Raycast(pos, step, params)

		if not hit and flightTime < 4 then
			pos += step
			ball.CFrame = CFrame.new(pos)
			return
		end

		conn:Disconnect()
		if not hit then
			ball:Destroy()
			return
		end

		pos = hit.Position + hit.Normal * 0.3
		ball.CFrame = CFrame.new(pos)

		-- stunning the monster
		local m = currentMonster
		local stunTime = 0
		if m and hit.Instance:IsDescendantOf(m.model) then
			stunTime = CONFIG.FlareStunDirect
		elseif m and (m.root.Position - pos).Magnitude <= CONFIG.FlareNearRadius then
			local p2 = RaycastParams.new()
			p2.FilterType = Enum.RaycastFilterType.Exclude
			p2.FilterDescendantsInstances = {m.model, ball}
			local toMonster = (m.root.Position + Vector3.new(0, 3, 0)) - pos
			if not workspace:Raycast(pos, toMonster, p2) then
				stunTime = CONFIG.FlareStunNear
			end
		end
		if stunTime > 0 then stunMonster(stunTime) end

		-- the flare burns and flickers
		task.spawn(function()
			local t0 = os.clock()
			while ball.Parent and os.clock() - t0 < CONFIG.FlareBurnTime do
				light.Brightness = 3 + math.random() * 3
				task.wait(0.05)
			end
			if ball.Parent then
				TweenService:Create(light, TweenInfo.new(1), {Brightness = 0}):Play()
				task.wait(1)
				ball:Destroy()
			end
		end)
	end)
end

