-- FX API (base). Gameplay code only talks to the FX table; nothing in here changes gameplay state.
FX.sound = function(name)
	local s = (name == "scare" and scareSnd) or (name == "hit" and hitSnd) or nil
	if s then s:Play() end
end

FX.shake = function(amount)
	if FEAT.CameraShake then shake = math.max(shake, amount) end
end

FX.static = function(amount)
	staticBurst = math.max(staticBurst, amount)
end

FX.hit = function()
	flash.BackgroundTransparency = 0.3
	TweenService:Create(flash, TweenInfo.new(0.7), {BackgroundTransparency = 1}):Play()
	FX.shake(1)
	staticBurst = 1
	FX.sound("hit")
	FX.sound("scare")
end

FX.spotted = function()
	staticBurst = 1
	FX.shake(0.5)
	glitch = 1
	FX.sound("scare")
end

FX.flicker = function(seconds)
	flickerUntil = math.max(flickerUntil, os.clock() + seconds)
end

FX.cinematic = function(on)
	camera = workspace.CurrentCamera
	if on then
		camera.CameraType = Enum.CameraType.Scriptable
	else
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 75
	end
end

FX.camera = function(cf, fieldOfView)
	camera.CFrame = cf
	if fieldOfView then camera.FieldOfView = fieldOfView end
end

FX.flashRed = function(alpha)
	flash.BackgroundTransparency = alpha
	TweenService:Create(flash, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
end

FX.fade = function(alpha) -- 0 = clear, 1 = black
	killFade.BackgroundTransparency = 1 - alpha
end

FX.fadeIn = function(seconds) -- from black to clear
	TweenService:Create(killFade, TweenInfo.new(seconds), {BackgroundTransparency = 1}):Play()
end

local function onHit() FX.hit() end
local function onSpotted() FX.spotted() end

