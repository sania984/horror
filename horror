-- ЗАПУСК: строим лес, переносим игрока, запускаем монстра
------------------------------------------------------------
task.spawn(function()
	local ch = player.Character or player.CharacterAdded:Wait()
	local hrp = ch:WaitForChild("HumanoidRootPart")
	task.wait(1)

	buildForest(hrp.Position)
	teleportToForest(ch)

	-- после смерти снова в лес, монстр уходит на новое место
	player.CharacterAdded:Connect(function(newCh)
		teleportToForest(newCh)
		monsterNeedsReset = true
	end)

	task.wait(1) -- даём навигации леса прогрузиться

	while true do
		local ok = runMonster()
		if not ok then
			task.wait(2)
		else
			task.wait(CONFIG.MonsterRespawnTime)
		end
	end
end)
