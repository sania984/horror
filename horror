local function pickupItem(kind)
	if kind == "flaregun" then
		hasFlareGun = true
		flares += 2
		updateFlareHud()
		showToast("Flare Gun and 2 flares  (G to fire)")
	elseif kind == "flares" then
		flares += 2
		updateFlareHud()
		showToast("+2 flares")
	elseif kind == "medkit" then
		medkits += 1
		showToast("Medkit added  [" .. CONFIG.MedkitHeal .. " HP]  (" .. CONFIG.MedkitKey.Name .. " to use)")
	elseif kind == "energy" then
		energies += 1
		showToast("Energy drink added  (" .. CONFIG.EnergyKey.Name .. " to drink)")
	end
	refreshInventory()
	if pickSnd then pickSnd:Play() end
end

local function makeItem(kind, pos, parent)
	local info = ITEM_INFO[kind]
	local model = Instance.new("Model")
	model.Name = "Item_" .. kind
	local cf = CFrame.new(pos) * CFrame.Angles(0, math.random() * 6.28, 0)
	local main

	local function piece(size, off, color, material, shape)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.Size = size
		p.CFrame = cf * off
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		if shape then p.Shape = shape end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	if kind == "flaregun" then
		main = piece(Vector3.new(0.6, 0.7, 1.9), CFrame.new(0, 0.5, 0), Color3.fromRGB(220, 90, 25))
		piece(Vector3.new(0.5, 1.0, 0.55), CFrame.new(0, -0.05, 0.55) * CFrame.Angles(0.25, 0, 0), Color3.fromRGB(30, 30, 32))
		piece(Vector3.new(0.4, 0.4, 0.9), CFrame.new(0, 0.55, -1.2), Color3.fromRGB(120, 120, 125), Enum.Material.Metal)
	elseif kind == "flares" then
		for i = -1, 1 do
			local f = piece(Vector3.new(1.1, 0.35, 0.35), CFrame.new(0, 0.2, i * 0.45), Color3.fromRGB(200, 30, 25))
			piece(Vector3.new(0.2, 0.3, 0.3), CFrame.new(0.65, 0.2, i * 0.45), Color3.fromRGB(255, 140, 60), Enum.Material.Neon)
			main = main or f
		end
	elseif kind == "medkit" then
		main = piece(Vector3.new(1.8, 1.0, 1.2), CFrame.new(0, 0.5, 0), Color3.fromRGB(235, 235, 235))
		piece(Vector3.new(1.0, 0.06, 0.28), CFrame.new(0, 1.03, 0), Color3.fromRGB(200, 20, 20))
		piece(Vector3.new(0.28, 0.06, 1.0), CFrame.new(0, 1.03, 0), Color3.fromRGB(200, 20, 20))
	else
		main = piece(Vector3.new(1.3, 0.7, 0.7), CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(40, 200, 170), Enum.Material.Metal, Enum.PartType.Cylinder)
		piece(Vector3.new(0.12, 0.74, 0.74), CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(200, 200, 205), Enum.Material.Metal, Enum.PartType.Cylinder)
	end

	-- faint glow so the item can be found in the dark
	new("PointLight", {Color = info.color, Range = 7, Brightness = 0.8}, main, true)

	local prompt = new("ProximityPrompt", {
		ActionText = "Take",
		ObjectText = info.label,
		HoldDuration = 0.2,
		MaxActivationDistance = 9,
		RequiresLineOfSight = false,
		KeyboardKeyCode = Enum.KeyCode.E,
	}, main)
	prompt.Triggered:Connect(function()
		pickupItem(kind)
		model:Destroy()
	end)

	model.PrimaryPart = main
	model.Parent = parent
	return model
end

