useMedkit = function()
	if killing then return end
	if medkits <= 0 then
		showToast("No medkits")
		return
	end
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	if hum.Health >= hum.MaxHealth then
		showToast("Health is already full")
		return
	end
	medkits -= 1
	hum.Health = math.min(hum.MaxHealth, hum.Health + CONFIG.MedkitHeal)
	if pickSnd then pickSnd:Play() end
	showToast("Medkit: +" .. CONFIG.MedkitHeal .. " HP")
	refreshInventory()
end

useEnergy = function()
	if killing then return end
	if energies <= 0 then
		showToast("No energy drinks")
		return
	end
	energies -= 1
	stamina = 1
	exhausted = false
	if pickSnd then pickSnd:Play() end
	showToast("Energy drink: stamina restored")
	refreshInventory()
end

