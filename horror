-- MIMIC (decoy): the monster disguises itself as a classic "Bacon hair" noob with a random name.
-- It jumps twice (or spins). If you come close, the noob convulses, its head twists around, its
-- torso tears in half, the body breaks apart and the monster crawls out of the skin.
------------------------------------------------------------
local pendingDecoyPoint = nil

local NAME_ADJ = {"Cool", "Epic", "Dark", "Super", "Pro", "Mega", "Happy", "Sleepy", "Tiny", "Fast", "Lucky", "Crazy"}
local NAME_NOUN = {"Gamer", "Builder", "Ninja", "Panda", "Wolf", "Dragon", "Noob", "Miner", "Racer", "Knight", "Cat", "Pizza"}

-- a different username every time
local function randomName()
	local a = NAME_ADJ[math.random(1, #NAME_ADJ)]
	local n = NAME_NOUN[math.random(1, #NAME_NOUN)]
	local style = math.random(1, 5)
	if style == 1 then return a .. n .. math.random(10, 9999)
	elseif style == 2 then return a .. "_" .. n
	elseif style == 3 then return "xX_" .. a .. n .. "_Xx"
	elseif style == 4 then return n .. math.random(100, 99999)
	end
	return a .. n .. "_" .. math.random(1, 99)
end

-- ground point in front of the player. Tries the strict version first (inside the view, clear line
-- of sight), then relaxes the rules so the mimic can almost always find a place to appear.
local function getPointInFront(distance)
	local tgt = getTarget()
	if not tgt then return nil end

	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then flat = tgt.hrp.CFrame.LookVector end
	flat = flat.Unit

	local ignore = {tgt.char}
	if itemsFolder then table.insert(ignore, itemsFolder) end
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignore
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = ignore
	local camPos = camera.CFrame.Position

	local function tryPoint(dir, d, needSight)
		local p0 = tgt.hrp.Position + dir * d
		local hit = workspace:Raycast(Vector3.new(p0.X, tgt.hrp.Position.Y + 6, p0.Z), Vector3.new(0, -80, 0), rayParams)
		if hit and hit.Normal.Y > 0.75 and hit.Material ~= Enum.Material.Water then
			local pos = hit.Position
			if #workspace:GetPartBoundsInRadius(pos + Vector3.new(0, 4, 0), 2.5, overlap) == 0 then
				if not needSight then return pos end
				local eye = pos + Vector3.new(0, 3, 0)
				if workspace:Raycast(camPos, eye - camPos, rayParams) == nil then return pos end
			end
		end
		return nil
	end

	-- 1) in front of you, in view, with a clear line of sight
	for _ = 1, 30 do
		local ang = (math.random() * 2 - 1) * math.rad(35)
		local dir = CFrame.Angles(0, ang, 0):VectorToWorldSpace(flat)
		local p = tryPoint(dir, distance * (0.55 + math.random() * 0.7), true)
		if p then return p end
	end
	-- 2) somewhere in front, even if the view is partly blocked
	for _ = 1, 20 do
		local ang = (math.random() * 2 - 1) * math.rad(60)
		local dir = CFrame.Angles(0, ang, 0):VectorToWorldSpace(flat)
		local p = tryPoint(dir, distance * (0.45 + math.random() * 0.8), false)
		if p then return p end
	end
	-- 3) any free ground around you
	return randomMapPoint(25, 60, tgt.hrp.Position)
end

-- a classic yellow noob with orange "bacon" hair and a fake name tag
local function buildDecoy()
	local skin = Color3.fromRGB(245, 205, 48)
	local shirt = Color3.fromRGB(13, 105, 172)
	local pants = Color3.fromRGB(40, 127, 71)
	local hairLight = Color3.fromRGB(214, 140, 60)
	local hairDark = Color3.fromRGB(150, 75, 30)

	local model = Instance.new("Model")
	model.Name = "HorrorDecoy"

	local function dpart(name, size, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local function djoint(p0, p1, c0, c1)
		local m = Instance.new("Motor6D")
		m.Name = p1.Name
		m.Part0 = p0
		m.Part1 = p1
		m.C0 = c0
		m.C1 = c1 or CFrame.new()
		m.Parent = p0
		return m
	end

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CanCollide = true
	root.Parent = model

	local torso = dpart("Torso", Vector3.new(2, 2, 1), shirt)
	djoint(root, torso, CFrame.new())

	local head = dpart("Head", Vector3.new(1.2, 1.2, 1.2), skin)
	local headPos = CFrame.new(0, 1, 0)
	local jHead = djoint(torso, head, headPos, CFrame.new(0, -0.6, 0))
	for _, side in ipairs({-1, 1}) do
		local eye = dpart("Eye", Vector3.new(0.22, 0.22, 0.1), Color3.new(0, 0, 0))
		djoint(head, eye, CFrame.new(side * 0.27, 0.12, -0.62))
	end
	local mouth = dpart("Mouth", Vector3.new(0.55, 0.1, 0.1), Color3.new(0, 0, 0))
	djoint(head, mouth, CFrame.new(0, -0.25, -0.62))

	-- bacon hair: an orange cap with darker "bacon stripes", side and back locks and a wavy fringe
	local function hairPart(size, off, color)
		local hp = dpart("Hair", size, color)
		djoint(head, hp, off)
		return hp
	end
	hairPart(Vector3.new(1.4, 0.45, 1.4), CFrame.new(0, 0.68, 0.02), hairLight)
	for i = 0, 3 do
		hairPart(Vector3.new(1.42, 0.07, 0.2), CFrame.new(0, 0.92, -0.5 + i * 0.35), hairDark)
	end
	hairPart(Vector3.new(1.4, 0.9, 0.35), CFrame.new(0, 0.2, 0.62), hairLight)
	hairPart(Vector3.new(0.3, 0.75, 1.2), CFrame.new(-0.67, 0.25, 0.05), hairLight)
	hairPart(Vector3.new(0.3, 0.75, 1.2), CFrame.new(0.67, 0.25, 0.05), hairLight)
	for i = -2, 2 do
		hairPart(Vector3.new(0.28, 0.3 + (i % 2) * 0.12, 0.2), CFrame.new(i * 0.27, 0.52, -0.62), (i % 2 == 0) and hairLight or hairDark)
	end

	local arms, legs = {}, {}
	for _, side in ipairs({-1, 1}) do
		local arm = dpart(side < 0 and "Left Arm" or "Right Arm", Vector3.new(1, 2, 1), skin)
		local armPos = CFrame.new(side * 1.5, 1, 0)
		arms[side] = {joint = djoint(torso, arm, armPos, CFrame.new(0, 1, 0)), pos = armPos}

		local leg = dpart(side < 0 and "Left Leg" or "Right Leg", Vector3.new(1, 2, 1), pants)
		local legPos = CFrame.new(side * 0.5, -1, 0)
		legs[side] = {joint = djoint(torso, leg, legPos, CFrame.new(0, 1, 0)), pos = legPos}
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 2
	humanoid.WalkSpeed = 16
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = model

	-- fake name tag (a failure here must never stop the mimic from spawning)
	local name = randomName()
	pcall(function()
		local tag = new("BillboardGui", {
			Size = UDim2.fromOffset(150, 24),
			StudsOffset = Vector3.new(0, 2.2, 0),
			AlwaysOnTop = false,
			MaxDistance = 140,
		}, head)
		new("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = name,
			Font = Enum.Font.SourceSansBold,
			TextSize = 18,
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeTransparency = 0.4,
		}, tag)
	end)

	model.PrimaryPart = root
	return {
		model = model, root = root, torso = torso, humanoid = humanoid, head = jHead, headPos = headPos,
		arms = arms, legs = legs, name = name, skin = skin,
	}
end

-- returns {pos, lookAt, torsoPos} if the player came close (the monster crawls out there), or nil
local function runDecoy(pos)
	local d = buildDecoy()
	local tgt0 = getTarget()
	local faceAt = tgt0 and Vector3.new(tgt0.hrp.Position.X, pos.Y + 3.2, tgt0.hrp.Position.Z) or (pos + Vector3.new(0, 3.2, -10))
	d.model.Parent = workspace
	d.model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 3.2, 0), faceAt))
	if CONFIG.DebugKeys then print("[HorrorMode] The mimic appeared: " .. d.name) end

	local mode = math.random() < 0.5 and "jump" or "spin"
	local startT = os.clock()
	local nextJump = startT + 1.2
	local jumpCount = 0
	local armsAngle = 0.05

	local conn = RunService.Heartbeat:Connect(function(dt)
		if not d.root.Parent then return end
		local airborne = d.humanoid.FloorMaterial == Enum.Material.Air
		local armTarget, legTarget = 0.05, 0
		if mode == "spin" then
			d.root.CFrame = d.root.CFrame * CFrame.Angles(0, dt * 7, 0)
			armTarget = 1.5
		elseif airborne then
			armTarget, legTarget = 2.6, 0.35
		end
		armsAngle += (armTarget - armsAngle) * math.min(dt * 14, 1)
		for _, side in ipairs({-1, 1}) do
			d.arms[side].joint.C0 = d.arms[side].pos * CFrame.Angles(0, 0, side * armsAngle)
			d.legs[side].joint.C0 = d.legs[side].pos * CFrame.Angles(0, 0, side * legTarget)
		end
	end)
	table.insert(conns, conn)

	local result = nil
	while d.model.Parent and alive do
		local now = os.clock()
		local tgt = getTarget()
		if not tgt then break end
		local dist = flatDist(tgt.hrp.Position, d.root.Position)

		if dist <= CONFIG.DecoyTriggerDistance then
			result = {pos = pos, lookAt = tgt.hrp.Position}
			break
		end
		if now - startT > CONFIG.DecoyLifetime or dist > CONFIG.TeleportTriggerDistance then
			break
		end

		-- jump twice, pause, repeat
		if mode == "jump" and now >= nextJump then
			d.humanoid.Jump = true
			jumpCount += 1
			nextJump = now + (jumpCount % 2 == 1 and 0.9 or 2.4)
		end
		task.wait(0.05)
	end

	pcall(function() conn:Disconnect() end)

	if not result then
		d.model:Destroy()
		return nil
	end

	-- reveal: the noob convulses and its head twists around backwards
	FX.spotted()
	local rootCF = d.root.CFrame
	local t0 = os.clock()
	while os.clock() - t0 < 1.0 and d.model.Parent and alive do
		local t = os.clock() - t0
		RunService.Heartbeat:Wait()
		d.root.CFrame = rootCF * CFrame.new((math.random() - 0.5) * 0.35, 0, (math.random() - 0.5) * 0.35)
		d.head.C0 = d.headPos * CFrame.Angles(0, math.min(t / 0.6, 1) * math.pi, 0)
		for _, side in ipairs({-1, 1}) do
			d.arms[side].joint.C0 = d.arms[side].pos * CFrame.Angles(0, 0, side * 0.05)
		end
		FX.static(1)
		FX.shake(0.4)
	end

	-- the skin tears: the torso splits in two, every part breaks off and flies apart
	FX.sound("hit")
	local torsoCF = d.torso.CFrame
	result.torsoPos = torsoCF.Position

	for _, obj in ipairs(d.model:GetDescendants()) do
		if obj:IsA("Motor6D") then obj:Destroy() end
	end
	d.humanoid:Destroy()
	d.root:Destroy()

	-- the torso becomes two halves
	local halfA = d.torso
	halfA.Size = Vector3.new(1, 2, 1)
	halfA.CFrame = torsoCF * CFrame.new(-0.5, 0, 0)
	local halfB = halfA:Clone()
	halfB.CFrame = torsoCF * CFrame.new(0.5, 0, 0)
	halfB.Parent = d.model

	-- shreds of torn yellow skin
	for _ = 1, 9 do
		local shred = Instance.new("Part")
		shred.Name = "Skin"
		shred.Size = Vector3.new(0.1, 0.5 + math.random() * 0.7, 0.4 + math.random() * 0.5)
		shred.Color = d.skin
		shred.Material = Enum.Material.SmoothPlastic
		shred.CFrame = torsoCF * CFrame.new((math.random() - 0.5) * 1.6, (math.random() - 0.5) * 1.6, (math.random() - 0.5) * 0.6)
			* CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		shred.Parent = d.model
	end

	for _, obj in ipairs(d.model:GetChildren()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = true
			obj.Massless = false
			obj.AssemblyLinearVelocity = Vector3.new(math.random(-18, 18), math.random(14, 30), math.random(-18, 18))
			obj.AssemblyAngularVelocity = Vector3.new(math.random(-12, 12), math.random(-12, 12), math.random(-12, 12))
		end
	end
	halfA.AssemblyLinearVelocity = Vector3.new(-16, 22, math.random(-6, 6))
	halfB.AssemblyLinearVelocity = Vector3.new(16, 22, math.random(-6, 6))

	-- a burst of dark goo from the chest
	pcall(function()
		local gooPart = new("Part", {
			Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1,
			Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(result.torsoPos),
		}, fxFolder)
		local goo = new("ParticleEmitter", {
			Texture = "rbxasset://textures/particles/smoke_main.dds",
			Rate = 0, Lifetime = NumberRange.new(0.5, 1.2), Speed = NumberRange.new(10, 22),
			SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.6, 1.8),
			Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)}),
			Color = ColorSequence.new(Color3.fromRGB(25, 3, 3), Color3.fromRGB(110, 10, 10)),
			LightInfluence = 1, Drag = 3,
		}, gooPart)
		goo:Emit(70)
		Debris:AddItem(gooPart, 3)
	end)

	local model = d.model
	task.delay(6, function()
		if model.Parent then model:Destroy() end
	end)

	return result
end

local function runMonster(opts)
	local emerge = opts and opts.emerge
	local spawnPos = emerge and (emerge.pos + Vector3.new(0, -30, 0)) or getMonsterSpawn()
	if not spawnPos then return false end

	local m = buildMonster()
	local model, humanoid, root = m.model, m.humanoid, m.root
	if emerge then root.Anchored = true end
	model.Parent = workspace
	model:PivotTo(CFrame.new(spawnPos))
	local me = {model = model, root = root, stunUntil = 0, state = "patrol"}
	currentMonster = me
	monsterNeedsReset = false

	local state = "patrol"
	local lastSeenPos, lastSeenT = nil, -math.huge
	local searchStarted = 0
	local scanUntil = 0          -- while now < scanUntil the monster stands still and looks around
	local dest, destSet = nil, 0
	local attackT, lastAttack = 0, 0
	local lastRoar, lastSpot = -math.huge, -math.huge
	local lastPos, lastPosTime = root.Position, os.clock()
	local wasStunned = false
	local seenFor, unseenFor = 0, 0
	local strikeAt = 0
	local lastTick = os.clock()
	local lastTeleport = -math.huge
	local wantDecoy = false
	local decoyAt, decoyTries = nil, 0
	local chaseTime = 0          -- seconds spent running after the player (the decoy trigger)
	local nextDecoyAt = os.clock() + math.random(CONFIG.DecoyMinInterval, CONFIG.DecoyMaxInterval)
	local adaptive = 1
	local forcedSpeed = nil      -- animation speed used while the monster is anchored (crawling out of the noob)

	-- speed: base value * difficulty (* adaptive boost while chasing)
	local function spdOf(base, chasing)
		local v = base * Diff.get("Speed")
		if chasing then v = v * adaptive end
		return v
	end

	-- pathfinding (falls back to straight movement if the game does not support it)
	local waypoints, wpIndex, pathGoal, pathTime = nil, 1, nil, 0
	local function followPath(goal)
		if not Support.Pathfinding then
			humanoid:MoveTo(goal)
			return true
		end
		if not waypoints or not pathGoal or (goal - pathGoal).Magnitude > 8 or os.clock() - pathTime > 1.5 then
			local path = PathfindingService:CreatePath({
				AgentRadius = 2.5,
				AgentHeight = 7,
				AgentCanJump = true,
				WaypointSpacing = 6,
			})
			local ok = pcall(function()
				path:ComputeAsync(root.Position, goal)
			end)
			pathGoal, pathTime = goal, os.clock()
			if ok and path.Status == Enum.PathStatus.Success then
				waypoints = path:GetWaypoints()
				wpIndex = 2
			else
				waypoints = nil
				humanoid:MoveTo(goal)
				return false
			end
		end

		local wp = waypoints[wpIndex]
		while wp and flatDist(wp.Position, root.Position) < 4 do
			wpIndex += 1
			wp = waypoints[wpIndex]
		end
		if wp then
			humanoid:MoveTo(wp.Position)
			if wp.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
		else
			humanoid:MoveTo(goal)
		end
		return true
	end

	-- animation, looking around, and turning to face the player while creeping behind
	local acc = 0
	local conn = RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 1 / 30 then return end
		local step = acc
		acc = 0
		local now = os.clock()
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		if forcedSpeed then speed = forcedSpeed end
		local scanning = now < scanUntil
		local facing = (state == "stalk" or state == "strike") and not killing
		humanoid.AutoRotate = not scanning and not killing and not facing
		if not root.Anchored then
			if scanning and speed < 2 then
				root.CFrame = root.CFrame * CFrame.Angles(0, math.sin(now * 0.9) * step * 1.6, 0)
			elseif facing then
				local tgt = getTarget()
				if tgt then
					local lookAt = Vector3.new(tgt.hrp.Position.X, root.Position.Y, tgt.hrp.Position.Z)
					if (lookAt - root.Position).Magnitude > 0.5 then
						root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, lookAt), math.clamp(step * 8, 0, 1))
					end
				end
			end
		end
		m.update(step, speed, state, attackT, now < me.stunUntil)
		attackT = math.max(0, attackT - step)
	end)
	table.insert(conns, conn)

	----------------------------------------------------------
	-- KILL SCENES (three variants). All visuals/audio go through the FX API.
	--   lunge  - the monster rushes you from the front, camera stares into its mouth
	--   grab   - it appears behind you, the camera whips around and you are lifted off the ground
	--   pounce - it leaps over you in an arc and lands on top of the camera
	----------------------------------------------------------
	local function pickKillVariant()
		local list = CONFIG.KillVariants
		if #list == 0 then return "lunge" end
		return list[math.random(1, #list)]
	end

	local function killSequence(target)
		-- kill animations switched off: plain death with the hit effect
		if not FEAT.KillAnimations then
			FX.hit()
			killPlayer(target)
			state = "patrol"
			dest, waypoints = nil, nil
			return
		end

		local variant = pickKillVariant()
		killing = true
		setInventory(false)
		state = "kill"
		attackT = 99
		m.setSilent(false)

		local ch, hum, hrp = target.char, target.hum, target.hrp
		pcall(function()
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.JumpHeight = 0
		end)
		pcall(function() hrp.Anchored = true end)
		humanoid.WalkSpeed = 0
		humanoid:MoveTo(root.Position)

		local look = camera.CFrame.LookVector
		local dir = Vector3.new(look.X, 0, look.Z)
		if dir.Magnitude < 0.1 then dir = hrp.CFrame.LookVector end
		dir = dir.Unit

		local ry = root.Position.Y
		local pFlat = Vector3.new(hrp.Position.X, ry, hrp.Position.Z)
		local headPart = ch:FindFirstChild("Head")
		local eyePos = headPart and headPart.Position or (hrp.Position + Vector3.new(0, 1.5, 0))
		local mhead = model:FindFirstChild("Head")

		root.Anchored = true
		root.AssemblyLinearVelocity = Vector3.zero

		local startPos, endPos
		if variant == "lunge" then
			startPos, endPos = pFlat + dir * 10, pFlat + dir * 4.5
		elseif variant == "grab" then
			startPos, endPos = pFlat - dir * 7, pFlat - dir * 3.4
		else
			local sideDir = Vector3.new(-dir.Z, 0, dir.X) * (math.random() < 0.5 and 1 or -1)
			startPos, endPos = pFlat + dir * 13 + sideDir * 3, pFlat + dir * 0.5
		end

		FX.cinematic(true)
		FX.spotted()
		if m.roar then
			m.roar.PlaybackSpeed = 0.28
			m.roar:Play()
		end
		FX.sound("scare")

		local total = (variant == "lunge" and 2.6) or (variant == "grab" and 2.5) or 2.3
		local t0 = os.clock()
		local struck = false
		while alive do
			RunService.RenderStepped:Wait()
			local t = os.clock() - t0
			if t >= total then break end

			local jitterAmt = 0.05 + t * 0.35
			local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * jitterAmt
			local camPos, lookAt, fovNow

			if variant == "lunge" then
				local a = math.clamp(t / 0.7, 0, 1)
				a = a * a * (3 - 2 * a)
				local p = startPos:Lerp(endPos, a)
				root.CFrame = CFrame.lookAt(p, pFlat)
				lookAt = ((mhead and mhead.Position) or (p + Vector3.new(0, 8, 0))) + jitter
				camPos = eyePos - dir * (t * 0.25) + jitter * 0.4
				fovNow = 75 - a * 18 + math.sin(t * 40) * (t * 1.5)

			elseif variant == "grab" then
				-- the camera whips around to the monster behind you, then you are lifted
				local turn = math.clamp(t / 0.35, 0, 1)
				turn = turn * turn * (3 - 2 * turn)
				local p = startPos:Lerp(endPos, math.clamp(t / 0.5, 0, 1))
				root.CFrame = CFrame.lookAt(p, pFlat)
				local forwardPt = eyePos + dir * 10
				local mh = (mhead and mhead.Position) or (p + Vector3.new(0, 8, 0))
				lookAt = forwardPt:Lerp(mh, turn) + jitter
				local lift = math.clamp((t - 0.5) / 1.0, 0, 1) * 2.4
				camPos = eyePos + Vector3.new(0, lift, 0) + jitter * 0.5
				fovNow = 78 + turn * 10 - math.clamp((t - 0.5) / 1.0, 0, 1) * 18

			else -- pounce
				local u = math.clamp(t / 0.8, 0, 1)
				local p = startPos:Lerp(endPos, u)
				local height = math.sin(u * math.pi) * 6 + u * u * 2
				root.CFrame = CFrame.lookAt(Vector3.new(p.X, ry + height, p.Z), Vector3.new(pFlat.X, ry + height * 0.6, pFlat.Z))
				lookAt = ((mhead and mhead.Position) or root.Position) + jitter
				camPos = eyePos + jitter * 0.4
				fovNow = 75 - u * 14 + math.sin(t * 40) * (t * 1.2)
			end

			FX.camera(CFrame.lookAt(camPos, lookAt), fovNow)

			-- the flashlight strobes and the screen fills with static
			if math.random() < 0.6 then FX.flicker(math.random() * 0.12) end
			FX.static(1)

			if t > total * 0.62 and not struck then
				struck = true
				FX.flashRed(0.1)
				FX.sound("hit")
			end
			if t > total - 0.5 then
				FX.fade(math.clamp((t - (total - 0.5)) / 0.5, 0, 1))
			end
		end

		FX.fade(1)
		killPlayer(target)
		pcall(function() hrp.Anchored = false end)
		FX.cinematic(false)
		root.Anchored = false
		killing = false
		attackT = 0
		state = "patrol"
		dest, waypoints = nil, nil
		task.delay(0.6, function()
			if alive then FX.fadeIn(0.8) end
		end)
	end

	-- EMERGE: the monster crawls out of the torn skin of the noob and starts chasing you
	local function emergeSequence()
		state = "chase" -- crawl pose
		forcedSpeed = 9
		local S = CONFIG.MonsterScale
		local gy = emerge.pos.Y
		local crawlY = gy + 5.9 * S      -- root height while crawling ((4.9 + 1) * S)
		local hideY = crawlY - 12 * S    -- the whole body starts hidden under the noob
		local from = Vector3.new(emerge.pos.X, 0, emerge.pos.Z)
		local toward = Vector3.new(emerge.lookAt.X - emerge.pos.X, 0, emerge.lookAt.Z - emerge.pos.Z)
		toward = toward.Magnitude > 0.1 and toward.Unit or Vector3.new(0, 0, -1)
		local total = 3.4
		local t0 = os.clock()
		if m.roar then
			m.roar.PlaybackSpeed = 0.28
			m.roar:Play()
		end
		while model.Parent and alive do
			RunService.Heartbeat:Wait()
			local t = os.clock() - t0
			if t >= total then break end
			local y, crawled
			if t < 1.4 then
				local a = t / 1.4
				a = a * a * (3 - 2 * a)
				y = hideY + (crawlY - hideY) * a
				crawled = 0
			else
				y = crawlY
				crawled = math.min((t - 1.4) * 4.5, 9) -- crawls a few studs toward you
			end
			local p = from + toward * crawled
			root.CFrame = CFrame.lookAt(Vector3.new(p.X, y, p.Z), Vector3.new(p.X + toward.X, y, p.Z + toward.Z))
			FX.static(0.5)
			FX.shake(0.25)
		end
		root.Anchored = false
		forcedSpeed = nil
		state = "chase"
		lastSeenT = os.clock()
		local tgt = getTarget()
		lastSeenPos = tgt and tgt.hrp.Position or root.Position
	end

	local function enterChase(now)
		state = "chase"
		scanUntil = 0
		if now - lastRoar > 10 then
			lastRoar = now
			if m.roar then
				m.roar.PlaybackSpeed = 0.3
				m.roar:Play()
			end
		end
		if now - lastSpot > 3 then
			lastSpot = now
			FX.spotted()
		end
	end

	local function enterStalk()
		state = "stalk"
		scanUntil = 0
		waypoints = nil
		if not stalkWarned then
			stalkWarned = true
			showToast("Something is creeping behind you. Don't turn around without a flare!")
		end
	end

	local function enterStrike(now)
		state = "strike"
		strikeAt = now + CONFIG.StrikeWindup * Diff.get("Windup")
		attackT = CONFIG.StrikeWindup * Diff.get("Windup") + 0.3
		if m.roar then
			m.roar.PlaybackSpeed = 0.3
			m.roar:Play()
		end
		FX.spotted()
	end

	-- the monster lost you after a long chase: a fake player will appear in front of you
	local function lostPlayer(now)
		if FEAT.Decoy and chaseTime >= CONFIG.DecoyAfterChaseSeconds then
			decoyAt = now + 1.5
			decoyTries = 0
		end
		chaseTime = 0
	end

	if emerge then emergeSequence() end

	while model.Parent and root.Parent and alive do
		local now = os.clock()
		local tickDt = now - lastTick
		lastTick = now
		me.state = state

		-- debug key [M]: summon the mimic right now
		local forced = false
		if debugForceDecoy then
			debugForceDecoy = false
			decoyAt, decoyTries = now, 0
			forced = true
		end

		-- player respawned -> the monster moves to a new place
		if monsterNeedsReset then
			monsterNeedsReset = false
			local p = getMonsterSpawn()
			if p then model:PivotTo(CFrame.new(p)) end
			state, scanUntil, dest, waypoints = "patrol", 0, nil, nil
			chaseTime, decoyAt = 0, nil
		end

		-- stunned by a flare: stands still, covers its face with its hands
		if now < me.stunUntil then
			if not wasStunned then
				wasStunned = true
				state = "patrol"
				scanUntil = 0
				if m.roar then
					m.roar.PlaybackSpeed = 0.55
					m.roar:Play()
				end
			end
			humanoid.WalkSpeed = 0
			humanoid:MoveTo(root.Position)
			task.wait(0.1)
			continue
		elseif wasStunned then
			wasStunned = false
			if m.roar then m.roar.PlaybackSpeed = 0.3 end
			local tgt = getTarget()
			if tgt then
				lastSeenPos = tgt.hrp.Position
				state = "search"
				searchStarted = now
				scanUntil = 0
				waypoints = nil
			end
		end

		local target = getTarget()
		local fdist = target and flatDist(target.hrp.Position, root.Position) or math.huge
		local sawNow = target ~= nil and canSee(root, target, model)   -- the monster sees the player (70 degree cone)
		local seen = target ~= nil and playerSeesMonster(model, root)  -- the player sees the monster

		if seen then
			seenFor += tickDt
			unseenFor = 0
		else
			unseenFor += tickDt
			seenFor = 0
		end
		if sawNow then
			lastSeenPos = target.hrp.Position
			lastSeenT = now
		end
		if state == "chase" or state == "stalk" or state == "strike" then chaseTime += tickDt end

		-- adaptive speed: faster when you are far ahead, a little slower when it is right on top of you
		adaptive = 1
		if FEAT.AdaptiveSpeed and target then
			local A = CONFIG.Adaptive
			if fdist > A.StartDistance then
				adaptive = 1 + (A.MaxBoost - 1) * math.clamp((fdist - A.StartDistance) / (A.FullDistance - A.StartDistance), 0, 1)
			elseif fdist < A.MercyDistance then
				adaptive = A.MercyMultiplier
			end
			if exhausted then adaptive = math.min(adaptive, 1) end
		end

		-- silent while it is behind you (no footsteps, no rumble)
		if FEAT.SilentBehind and target then
			local cf = camera.CFrame
			local toM = root.Position - cf.Position
			local behind = (toM.X * cf.LookVector.X + toM.Z * cf.LookVector.Z) < 0
			m.setSilent(behind and state ~= "strike" and state ~= "kill" and state ~= "emerge")
		else
			m.setSilent(false)
		end

		-- teleport: if the player got too far away, jump to a point TeleportDistance from the player
		if FEAT.Teleport and target and fdist > CONFIG.TeleportTriggerDistance and now - lastTeleport > CONFIG.TeleportCooldown then
			lastTeleport = now
			local c = target.hrp.Position
			local pick
			for _ = 1, 6 do
				local pt = randomMapPoint(CONFIG.TeleportDistance - 10, CONFIG.TeleportDistance + 10, c)
				if pt then
					pick = pt
					if canReach(c, pt) then break end
				end
			end
			if pick then
				model:PivotTo(CFrame.new(pick + Vector3.new(0, 9, 0)))
				root.AssemblyLinearVelocity = Vector3.zero
				state, scanUntil, dest, waypoints = "patrol", 0, nil, nil
				fdist = flatDist(c, root.Position)
				sawNow, seen = false, false
				chaseTime = 0
			end
		end

		-- mimic: queued after a long chase was lost, at random times, or with the debug key
		local decoyReady = FEAT.Decoy and ((decoyAt ~= nil and now >= decoyAt) or (CONFIG.DecoyRandom and now >= nextDecoyAt))
		if decoyReady and target and fdist > 12 and (state == "patrol" or state == "search" or forced) then
			local dp = getPointInFront(CONFIG.DecoyDistance)
			if dp then
				if CONFIG.DebugKeys then print("[HorrorMode] The mimic is spawning") end
				pendingDecoyPoint = dp
				wantDecoy = true
				break
			end
			decoyTries += 1
			if decoyAt then
				decoyAt = (decoyTries > 12) and nil or (now + 1)
			end
			nextDecoyAt = now + 5
		end

		-- state transitions
		if state == "patrol" or state == "search" then
			if sawNow then
				if seen or not FEAT.Stalking then enterChase(now) else enterStalk() end
			end
		elseif state == "chase" then
			if not target then
				state = "patrol"
				dest, waypoints = nil, nil
				chaseTime = 0
			elseif FEAT.Stalking and sawNow and unseenFor > 0.35 then
				enterStalk() -- the player looked away: the monster crouches and creeps up behind
			elseif not sawNow and now - lastSeenT > CONFIG.MonsterSightMemory then
				state = "search"
				searchStarted = now
				scanUntil = 0
				waypoints = nil
				lostPlayer(now)
			end
		elseif state == "stalk" then
			if not target then
				state = "patrol"
				dest, waypoints = nil, nil
			elseif seenFor >= 0.1 then
				-- the player turned around and saw the monster
				if fdist <= CONFIG.StalkStrikeRange then
					enterStrike(now)
				else
					enterChase(now)
				end
			elseif (not sawNow and now - lastSeenT > 2.5) or fdist > CONFIG.StalkMaxRange then
				state = "search"
				searchStarted = now
				scanUntil = 0
				waypoints = nil
				lostPlayer(now)
			end
		end

		-- behavior in the current state
		if state == "chase" then
			local base = (sawNow and fdist < 35) and CONFIG.MonsterLungeSpeed or CONFIG.MonsterChaseSpeed
			humanoid.WalkSpeed = spdOf(base, true)
			if sawNow then
				humanoid:MoveTo(target.hrp.Position)
			elseif lastSeenPos then
				followPath(lastSeenPos)
			end

			if target and fdist <= CONFIG.MonsterAttackRange
				and now - lastAttack >= CONFIG.MonsterAttackCooldown then
				lastAttack = now
				if target.hum.Health <= CONFIG.MonsterDamage + 1 then
					killSequence(target)
				else
					attackT = 0.45
					if m.hit then m.hit:Play() end
					FX.hit()
					target.hum:TakeDamage(CONFIG.MonsterDamage)
				end
			end

		elseif state == "stalk" then
			-- creeps crouched behind you and keeps its distance
			humanoid.WalkSpeed = spdOf(CONFIG.MonsterStalkSpeed, false)
			if target then
				if fdist > CONFIG.StalkDistance + 2 then
					if sawNow then
						humanoid:MoveTo(target.hrp.Position)
					elseif lastSeenPos then
						followPath(lastSeenPos)
					end
				else
					humanoid:MoveTo(root.Position)
				end
			end

		elseif state == "strike" then
			-- lunge: the player has StrikeWindup seconds to fire a flare
			humanoid.WalkSpeed = spdOf(CONFIG.MonsterLungeSpeed, true)
			if not target then
				state = "patrol"
				dest, waypoints = nil, nil
			else
				humanoid:MoveTo(target.hrp.Position)
				if now >= strikeAt or fdist <= CONFIG.MonsterAttackRange then
					killSequence(target)
				end
			end

		elseif state == "search" then
			humanoid.WalkSpeed = spdOf(CONFIG.MonsterSearchSpeed, false)
			if scanUntil == 0 then
				if (lastSeenPos and flatDist(root.Position, lastSeenPos) < 6) or now - searchStarted > 15 or not lastSeenPos then
					scanUntil = now + CONFIG.MonsterSearchTime
					humanoid:MoveTo(root.Position)
				else
					followPath(lastSeenPos)
				end
			elseif now >= scanUntil then
				state = "patrol"
				scanUntil = 0
				dest, waypoints = nil, nil
			else
				humanoid:MoveTo(root.Position)
			end

		else -- patrol
			humanoid.WalkSpeed = spdOf(CONFIG.MonsterWanderSpeed, false)
			if now < scanUntil then
				humanoid:MoveTo(root.Position)
			else
				if dest and flatDist(root.Position, dest) < 6 then
					scanUntil = now + math.random(2, 4)
					dest = nil
				elseif not dest or now - destSet > 25 then
					dest = randomMapPoint(25, 120)
					if not dest then
						dest = root.Position + Vector3.new(math.random(-40, 40), 0, math.random(-40, 40))
					end
					destSet = now
					waypoints = nil
				end
				if dest and not followPath(dest) then dest = nil end
			end
		end

		-- stuck: jump and look for another path
		if os.clock() - lastPosTime > 1.5 then
			local standing = os.clock() < scanUntil
				or (state == "stalk" and fdist <= CONFIG.StalkDistance + 2)
				or state == "strike"
			if not standing and (root.Position - lastPos).Magnitude < 2 then
				humanoid.Jump = true
				waypoints = nil
				if state == "patrol" then dest = nil end
			end
			lastPos, lastPosTime = root.Position, os.clock()
		end

		if root.Position.Y < mapOrigin.Y - 400 then break end

		task.wait(state == "strike" and 0.05 or 0.15)
	end

	pcall(function() conn:Disconnect() end)
	currentMonster = nil
	if model.Parent then model:Destroy() end
	if wantDecoy then return "decoy" end
	return true
end


------------------------------------------------------------
-- QUALITY: the auto-quality system lowers the preset when the frame rate drops
------------------------------------------------------------
local function applyQuality()
	lines.Visible = Q.Scanlines > 0
	for i, dot in ipairs(dots) do
		dot.Visible = i <= Q.Dots
	end
	Torch.setQuality(Q, FEAT.FlashlightFX)
	if typeof(bloom) == "Instance" then bloom.Enabled = Q.Bloom end
end

local function lowerQuality()
	local idx
	for i, n in ipairs(QUALITY_ORDER) do
		if n == qualityName then idx = i end
	end
	if not idx or idx >= #QUALITY_ORDER then return end
	qualityName = QUALITY_ORDER[idx + 1]
	for k, v in pairs(CONFIG.QualityPresets[qualityName]) do Q[k] = v end
	applyQuality()
	print("[HorrorMode] Low frame rate - quality lowered to " .. qualityName)
end

Torch.setQuality(Q, FEAT.FlashlightFX)

-- features that need the old-camera layer are hidden when it is switched off
if not FEAT.VHSOverlay then
	lines.Visible = false
	for _, f in ipairs(vignette) do f.Visible = false end
	for _, dot in ipairs(dots) do dot.Visible = false end
	bar.Visible = false
	if typeof(cc) == "Instance" then cc.Enabled = false end
	if typeof(blur) == "Instance" then blur.Enabled = false end
else
	applyQuality()
end

------------------------------------------------------------
-- 6. MAIN LOOP
------------------------------------------------------------
local threatT = 0

C(RunService.RenderStepped, function(dt)
	if not alive then return end
	local now = os.clock()
	camera = workspace.CurrentCamera
	if not FEAT.PlayerCrawl then playerCrawl = false end
	pCrawlK += ((playerCrawl and 1 or 0) - pCrawlK) * math.min(dt * 7, 1)

	-- monster proximity
	local target = 0
	local monsterDist = math.huge
	if currentMonster and currentMonster.root.Parent then
		monsterDist = (currentMonster.root.Position - camera.CFrame.Position).Magnitude
		target = math.clamp(1 - monsterDist / CONFIG.EffectRange, 0, 1)
	end
	intensity += (target - intensity) * math.min(dt * 3, 1)
	staticBurst = math.max(0, staticBurst - dt * 1.5)
	glitch = math.max(0, glitch - dt * 4)
	shake = math.max(0, shake - dt * 1.2)
	eff = math.clamp(intensity + staticBurst, 0, 1)

	-- FX layer (a failing FX system can never break the game)
	local okFx, errFx = pcall(FX.update, dt, now, monsterDist)
	if not okFx then
		FX.failures = (FX.failures or 0) + 1
		warn("[HorrorMode] FX error: " .. tostring(errFx))
		if FX.failures >= 3 then
			FX.disableAll()
			warn("[HorrorMode] FX layer switched off after repeated errors.")
		end
	end

	-- sprint, stamina, head bob
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and not saved.walkSpeed then saved.walkSpeed = humanoid.WalkSpeed end
	local sprinting = false
	local moveSpeed = 0
	if humanoid and humanoid.Health > 0 and not killing then
		local moving = humanoid.MoveDirection.Magnitude > 0.1
		sprinting = FEAT.Sprint and sprintHeld and moving and not exhausted and stamina > 0 and not playerCrawl

		if sprinting then
			stamina -= dt / CONFIG.StaminaSeconds
			if stamina <= 0 then
				stamina = 0
				exhausted = true
			end
		else
			stamina = math.min(1, stamina + dt / CONFIG.StaminaRegenSeconds * (playerCrawl and 1.6 or 1))
			if exhausted and stamina >= 0.3 then
				exhausted = false
			end
		end

		if playerCrawl then
			humanoid.WalkSpeed = CONFIG.PlayerCrawlSpeed
		elseif sprinting then
			humanoid.WalkSpeed = CONFIG.PlayerSprintSpeed
		elseif exhausted then
			humanoid.WalkSpeed = CONFIG.PlayerWalkSpeed * 0.8
		else
			humanoid.WalkSpeed = CONFIG.PlayerWalkSpeed
		end

		local rootPart = humanoid.RootPart
		local speed = 0
		if rootPart then
			local v = rootPart.AssemblyLinearVelocity
			speed = Vector3.new(v.X, 0, v.Z).Magnitude
		end
		moveSpeed = speed
		bobT += dt * speed * 0.9
		local amp = math.clamp(speed / 16, 0, 1.2) * 0.12
		local shakeScale = FEAT.CameraShake and CONFIG.Shake.Intensity or 0
		local sh = (shake + eff * 0.15) * 0.25 * shakeScale
		humanoid.CameraOffset = Vector3.new(
			math.sin(bobT * 0.5) * amp * 0.6 + (math.random() - 0.5) * sh,
			math.abs(math.sin(bobT * 0.5)) * amp + (math.random() - 0.5) * sh - CONFIG.CrawlCameraDrop * pCrawlK,
			0
		)
	else
		stamina, exhausted = 1, false
		playerCrawl = false
	end

	fov += ((sprinting and 84 or 75) - 6 * pCrawlK - fov) * math.min(dt * 6, 1)
	if not killing then camera.FieldOfView = fov end

	-- player footsteps (default ones disabled; custom ones depend on surface and sprinting)
	if stepSnd and FEAT.PlayerFootsteps then
		local rootPart = humanoid and humanoid.RootPart
		local running = rootPart and rootPart:FindFirstChild("Running")
		if running and running:IsA("Sound") and running.Volume ~= 0 then
			saved.runningVolume = saved.runningVolume or running.Volume
			running.Volume = 0
		end
		local walking = false
		if humanoid and humanoid.Health > 0 and not killing and rootPart then
			local v = rootPart.AssemblyLinearVelocity
			local spd = Vector3.new(v.X, 0, v.Z).Magnitude
			local mat = humanoid.FloorMaterial
			walking = spd > 2 and mat ~= Enum.Material.Air
			if walking then
				local vol, pitch = 0.6, 1.0
				if mat == Enum.Material.Grass or mat == Enum.Material.LeafyGrass or mat == Enum.Material.Ground
					or mat == Enum.Material.Mud or mat == Enum.Material.Sand or mat == Enum.Material.Snow then
					vol, pitch = 0.45, 0.85       -- soft ground and grass
				elseif mat == Enum.Material.Wood or mat == Enum.Material.WoodPlanks then
					vol, pitch = 0.9, 1.1         -- creaky wooden floors
				elseif mat == Enum.Material.Slate or mat == Enum.Material.Concrete or mat == Enum.Material.Rock
					or mat == Enum.Material.Cobblestone or mat == Enum.Material.Metal then
					vol, pitch = 0.8, 1.0
				end
				if sprinting then
					vol *= 1.5
					pitch *= 1.25
				end
				vol *= (1 - 0.7 * pCrawlK) -- crawling is quiet
				stepSnd.Volume = vol
				stepSnd.PlaybackSpeed = (0.55 + spd / 40) * pitch
			end
		end
		if stepSnd.Playing ~= walking then stepSnd.Playing = walking end
	end

	-- status line in the inventory
	if invOpen then
		local hp = humanoid and math.floor(humanoid.Health) or 0
		local maxHp = humanoid and math.floor(humanoid.MaxHealth) or 0
		invFooter.Text = string.format("HP %d/%d     Stamina %d%%", hp, maxHp, math.floor(stamina * 100))
	end

	staminaBack.Visible = FEAT.Sprint and stamina < 0.999
	staminaFill.Size = UDim2.fromScale(stamina, 1)
	staminaFill.BackgroundColor3 = exhausted and Color3.fromRGB(220, 60, 60) or Color3.new(1, 1, 1)

	-- flashlight: random flicker patterns (FX), plus a quick blink when the monster is near
	if FEAT.Flicker then
		flickerCheck -= dt
		if flickerCheck <= 0 then
			flickerCheck = 0.25
			if monsterDist < 40 and math.random() < CONFIG.Flicker.NearMonsterChance then
				flickerUntil = now + 0.08 + math.random() * 0.12
			end
		end
	end
	local torchOn = flashOn and now >= flickerUntil and not FX.flickerOff()
	Torch.update(dt, now, torchOn, FX.flickerDim(), moveSpeed, pCrawlK, currentMonster and currentMonster.model)

	-- post effects
	if FEAT.VHSOverlay then
		blur.Size = 1.2 + eff * 5
		cc.Saturation = -0.35 - eff * 0.4
		cc.Contrast = 0.25 + eff * 0.2
		cc.Brightness = -0.02 + glitch * 0.1 * (0.5 + math.random() * 0.5)
		cc.TintColor = FX.tint() or Color3.fromRGB(225, 235, 215):Lerp(Color3.fromRGB(255, 170, 170), eff * 0.5)
		for _, f in ipairs(vignette) do
			f.BackgroundTransparency = 0.35 - eff * 0.3
		end

		if Q.Scanlines > 0 then
			lines.Position = UDim2.new(0, 0, 0, (now * 25) % Q.Scanlines)
		end

		noiseT -= dt
		if noiseT <= 0 then
			noiseT = Q.NoiseRate
			local vp = camera.ViewportSize
			for i = 1, math.min(#dots, Q.Dots) do
				local dot = dots[i]
				local sz = math.random(1, 3 + math.floor(eff * 3))
				dot.Size = UDim2.fromOffset(sz, sz * math.random(1, 2))
				dot.Position = UDim2.fromOffset(math.random(0, vp.X), math.random(0, vp.Y))
				dot.BackgroundTransparency = 0.9 - eff * 0.5 - math.random() * 0.1
				dot.BackgroundColor3 = math.random() < 0.5 and Color3.new(1, 1, 1) or Color3.fromRGB(150, 150, 150)
			end
		end

		recDot.Visible = (now % 1.2) < 0.7
		secT -= dt
		if secT <= 0 then
			secT = 1
			local s = os.time() - startTime
			timeLabel.Text = string.format("%02d:%02d:%02d", math.floor(s / 3600), math.floor(s / 60) % 60, s % 60)
		end
	end

	-- threat label (difficulty)
	threatT -= dt
	if threatT <= 0 then
		threatT = 2
		if threatLabel.Visible then updateThreat() end
	end

	-- heartbeat
	if beat and FEAT.Heartbeat then
		beatT -= dt
		if beatT <= 0 then
			local bpm = 55 + eff * 100 + (1 - stamina) * 40
			beatT = 60 / bpm
			beat.Volume = 0.15 + eff * 0.9
			beat:Play()
			task.delay(0.17, function()
				if alive and beat then
					beat.Volume = beat.Volume * 0.7
					beat:Play()
				end
			end)
		end
	end

	-- auto quality: if the average frame rate stays low, drop one quality level
	fpsT += dt
	fpsN += 1
	if fpsT >= 3 then
		local fps = fpsN / fpsT
		fpsT, fpsN = 0, 0
		if CONFIG.AutoQuality and fps < CONFIG.AutoQualityFps then
			lowerQuality()
		end
	end
end)

