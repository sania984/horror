function Hub:destroy()
	if not self.alive then return end
	self.alive = false
	for _, c in ipairs(self.conns) do pcall(function() c:Disconnect() end) end
	if self.gui then pcall(function() self.gui:Destroy() end) end
	if self.folder then pcall(function() self.folder:Destroy() end) end
	for _, s in ipairs(self.sounds) do pcall(function() s:Destroy() end) end

	unstashLightingObjects(self.stashed or {})
	restoreLighting(self.saved.lighting)

	local cam = workspace.CurrentCamera
	pcall(function()
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = self.saved.fov
	end)

	local f = self.frozen
	if f.hum and f.hum.Parent then
		f.hum.WalkSpeed, f.hum.JumpPower, f.hum.JumpHeight = f.walk or 16, f.jumpPower or 50, f.jumpHeight or 7.2
	end
	if f.hrp and f.hrp.Parent then
		f.hrp.Anchored = f.anchored or false
	end
end

-- PLAY: fade to black, tear the lobby down and start the game (the game fades back in)
function Hub:play(onPlay)
	if self.busy then return end
	self.busy = true
	local tw = TweenService:Create(self.fade, TweenInfo.new(0.6), {BackgroundTransparency = 0})
	tw:Play()
	tw.Completed:Wait()
	self:destroy()
	onPlay()
end

-- STOP: fade to black and shut everything down
function Hub:stop(onStop)
	if self.busy then return end
	self.busy = true
	local tw = TweenService:Create(self.fade, TweenInfo.new(0.5), {BackgroundTransparency = 0})
	tw:Play()
	tw.Completed:Wait()
	onStop()
end


------------------------------------------------------------
-- GAME SESSION
-- startGame() builds the whole game. It returns nothing; the session is ended with stopGame(),
-- which disconnects every connection, destroys everything it created and restores the game.
------------------------------------------------------------
local function startGame(opts)
	opts = opts or {}
	local alive = true
	local conns = {}
	local function C(signal, fn)
		local c = signal:Connect(fn)
		table.insert(conns, c)
		return c
	end

	local camera = workspace.CurrentCamera

	-- quality: a mutable copy of the preset (the auto-quality system can lower it while playing)
	local QUALITY_ORDER = {"High", "Medium", "Low"}
	local qualityName = CONFIG.QualityPresets[CONFIG.Quality] and CONFIG.Quality or "Medium"
	local Q = {}
	for k, v in pairs(CONFIG.QualityPresets[qualityName]) do Q[k] = v end

	-- everything the game changes is remembered here so Stop can put it back
	local saved = {
		cameraMode = player.CameraMode,
		fov = camera.FieldOfView,
		lighting = snapshotLighting(),
		stashed = {},
		lights = setmetatable({}, {__mode = "k"}),
		walkSpeed = nil,
	}

	-- forward declarations shared by the layers
	local stopGame
	local FX = {}                 -- the FX API: the only thing gameplay code uses for visuals and audio
	local itemRegistry = {}       -- items for the [E] pickup fallback (when ProximityPrompts are unsupported)
	local pickupNearest = function() end
	local lastDim = 1
	local debugForceDecoy = false
	local fpsT, fpsN = 0, 0

	-- difficulty rises with time; Diff.get("Speed") etc. return the current multiplier
	local Diff = {t0 = os.clock()}
	function Diff.level()
		if not FEAT.Difficulty then return 0 end
		return math.clamp((os.clock() - Diff.t0) / CONFIG.Difficulty.RampSeconds, 0, 1)
	end
	function Diff.get(name)
		local r = CONFIG.Difficulty[name]
		if not FEAT.Difficulty or type(r) ~= "table" then return 1 end
		return r[1] + (r[2] - r[1]) * Diff.level()
	end

	------------------------------------------------------------
	-- 1. DARKNESS AND FOG (values are held even if the game tries to change them)
	------------------------------------------------------------
	if CONFIG.FirstPerson then
		pcall(function()
			player.CameraMode = Enum.CameraMode.LockFirstPerson
		end)
	end

	local function applyLightingProps()
		pcall(function()
			Lighting.ClockTime = 0
			Lighting.Brightness = 0
			Lighting.Ambient = Color3.new(0, 0, 0)
			Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
			Lighting.ColorShift_Top = Color3.new(0, 0, 0)
			Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)
			Lighting.GlobalShadows = true
			Lighting.EnvironmentDiffuseScale = 0
			Lighting.EnvironmentSpecularScale = 0
			Lighting.FogColor = Color3.new(0, 0, 0)
			Lighting.FogStart = 0
			Lighting.FogEnd = CONFIG.FogEnd
		end)
	end

	-- the game's own sky/atmosphere/effects are moved out (and restored on Stop)
	saved.stashed = stashLightingObjects()
	C(Lighting.ChildAdded, function(c)
		task.defer(function()
			if alive and (c:IsA("Sky") or c:IsA("Atmosphere") or c:IsA("PostEffect")) and not c:GetAttribute("HorrorKeep") then
				table.insert(saved.stashed, c)
				c.Parent = nil
			end
		end)
	end)

	new("Sky", {
		SkyboxBk = "", SkyboxDn = "", SkyboxFt = "",
		SkyboxLf = "", SkyboxRt = "", SkyboxUp = "",
		StarCount = 0,
		CelestialBodiesShown = false,
	}, Lighting, true)

	new("Atmosphere", {
		Density = 0.55,
		Offset = 0,
		Color = Color3.new(0, 0, 0),
		Decay = Color3.new(0, 0, 0),
		Glare = 0,
		Haze = 10,
	}, Lighting, true)

	applyLightingProps()
	task.spawn(function()
		while alive do
			task.wait(1)
			applyLightingProps()
		end
	end)

	if CONFIG.DisableMapLights then
		local function killLight(obj)
			if (obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight"))
				and not obj:GetAttribute("HorrorKeep") and obj.Enabled then
				saved.lights[obj] = true
				obj.Enabled = false
			end
		end
		for _, o in ipairs(workspace:GetDescendants()) do killLight(o) end
		C(workspace.DescendantAdded, killLight)
	end

