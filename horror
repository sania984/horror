------------------------------------------------------------
task.spawn(function()
	local ch = player.Character or player.CharacterAdded:Wait()
	local hrp = ch:WaitForChild("HumanoidRootPart")
	task.wait(1)
	mapOrigin = hrp.Position

	spawnItems()

	-- after you die the monster moves to a new place near your new spawn
	player.CharacterAdded:Connect(function()
		monsterNeedsReset = true
	end)

	local opts = nil
	while true do
		local result = runMonster(opts)
		opts = nil
		if result == "decoy" then
			-- the monster is disguised as a player; when you come close it emerges
			local info = runDecoy(pendingDecoyPoint)
			if info then opts = {emerge = info} end
		elseif not result then
			task.wait(2)
		else
			task.wait(CONFIG.MonsterRespawnTime)
		end
	end
end)
