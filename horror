-- FLASHLIGHT (visual system, client-side)
--   * five stacked spotlights give a hot center that falls off smoothly (no hard edge)
--   * a bounce light follows the spot on the wall: the light "spills" onto the surroundings
--   * dust floats through the beam, plus faint dust in the air that only shows where the light touches
--   * a flashlight model is held in your hand and the beam starts at its lens
--   * the light warms up when switched on and the filament shimmers slightly
------------------------------------------------------------
local FXC = CONFIG.FlashlightFX
local Torch = {
	level = 0, t = 0, viewCF = camera.CFrame, bouncePos = nil, rayT = 0,
	layers = {}, viewParts = {}, attached = {}, layerCount = 5, bounceAllowed = true, lensOn = false,
	rayParams = RaycastParams.new(),
}
Torch.rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function torchPart(props)
	props.Anchored = true
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	local p = new("Part", props, nil, true)
	p.Parent = camera
	table.insert(Torch.attached, p)
	return p
end

local lightPart = torchPart({Name = "HorrorFlashlight", Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2)})
Torch.part = lightPart

-- stacked spot lights, in priority order (a lower quality keeps only the first ones)
local LAYER_DEFS = {
	{angle = 6,  mult = 1.00, color = Color3.fromRGB(255, 252, 240), range = 1.00, shadows = true},   -- hot core
	{angle = 18, mult = 0.50, color = Color3.fromRGB(255, 238, 200), range = 1.00, shadows = true},   -- main beam
	{angle = 30, mult = 0.30, color = Color3.fromRGB(255, 226, 180), range = 0.85, shadows = false},  -- soft edge
	{angle = 11, mult = 0.70, color = Color3.fromRGB(255, 246, 222), range = 1.00, shadows = false},  -- inner glow
	{angle = 52, mult = 0.10, color = Color3.fromRGB(255, 214, 165), range = 0.55, shadows = false},  -- faint spill
}
for _, def in ipairs(LAYER_DEFS) do
	local base = FXC.Brightness * def.mult
	local light = new("SpotLight", {
		Face = Enum.NormalId.Front,
		Range = CONFIG.FlashlightRange * def.range,
		Brightness = base,
		Angle = def.angle,
		Color = def.color,
		Shadows = def.shadows and Q.Shadows,
		Enabled = true,
	}, lightPart, true)
	table.insert(Torch.layers, {light = light, base = base, shadows = def.shadows})
end

