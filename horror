local function hasLineOfSight(fromPos, targetChar, monsterModel)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {monsterModel, targetChar}
	for _, name in ipairs({"HumanoidRootPart", "Head"}) do
		local p = targetChar:FindFirstChild(name)
		if p and workspace:Raycast(fromPos, p.Position - fromPos, params) == nil then
			return true
		end
	end
	return false
end

-- sees only inside the MonsterFOV cone ahead, within range and with no obstacles.
-- If the flashlight is on, the sight range is multiplied by FlashlightSightMultiplier.
local function canSee(root, target, model)
	local toPlayer = target.hrp.Position - root.Position
	local flat = Vector3.new(toPlayer.X, 0, toPlayer.Z)
	local d = flat.Magnitude
	local range = CONFIG.MonsterSightRange * (flashOn and CONFIG.FlashlightSightMultiplier or 1) * Diff.get("Sight") * (1 - (1 - CONFIG.CrawlSightMultiplier) * pCrawlK)
	if d > range then return false end
	if d > 0.5 then
		local look = root.CFrame.LookVector
		local lookFlat = Vector3.new(look.X, 0, look.Z)
		if lookFlat.Magnitude < 0.01 then return false end
		if lookFlat.Unit:Dot(flat.Unit) < math.cos(math.rad(CONFIG.MonsterFOV / 2)) then
			return false
		end
	end
	local headPart = model:FindFirstChild("Head")
	local eye = headPart and headPart.Position or (root.Position + Vector3.new(0, 4, 0))
	return hasLineOfSight(eye, target.char, model)
end

------------------------------------------------------------
-- MONSTER LOGIC
--   patrol -> sees the player:
--       player looks at the monster -> chase (runs and hits)
--       player looks elsewhere -> stalk (crouches and creeps up behind)
--   stalk  -> player turns around and sees the monster -> strike (lunge) -> death unless stunned with a flare
--   chase  -> player looks away -> stalk
--   lost sight -> search -> patrol
-- plus flare stun, teleport, decoy (fake player) and the kill scene
------------------------------------------------------------
local stalkWarned = false

-- does the player see the monster (on screen and unobstructed)
local function playerSeesMonster(model, root)
	local origin = camera.CFrame.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {model}
	if player.Character then table.insert(ignore, player.Character) end
	params.FilterDescendantsInstances = ignore

	local head = model:FindFirstChild("Head")
	local points = {root.Position, head and head.Position or (root.Position + Vector3.new(0, 4, 0))}
	for _, p in ipairs(points) do
		local _, onScreen = camera:WorldToViewportPoint(p)
		if onScreen and workspace:Raycast(origin, p - origin, params) == nil then
			return true
		end
	end
	return false
end

